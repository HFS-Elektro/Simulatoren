/* ================= Verbinden ================= */
function tryConnect(a,b){
  let o,i;
  if(a.kind==='pin-out'&&b.kind==='pin-in'){o=a;i=b;}else if(a.kind==='pin-in'&&b.kind==='pin-out'){o=b;i=a;}
  else{toast(a.kind==='pin-out'?'Ein Ausgang muss mit einem Eingang verbunden werden.':'Ein Eingang braucht einen Ausgang als Partner.');return false;}
  if(o.id===i.id){toast('Ein Baustein kann nicht mit sich selbst verbunden werden.');return false;}
  {const ob=byId(o.id),ib=byId(i.id);const ao=isAnaOut(ob.t),ai=isAnaIn(ib.t,i.pin);
   if(ao&&!ai){toast('Ein Analogsignal (orange) passt nur an einen Analogeingang Ax/Ay.');return false;}
   if(!ao&&ai){toast('An Ax/Ay gehört ein Analogsignal (z. B. AI1) – kein 0/1-Signal.');return false;}}
  if(S.wires.some(w=>w.f===o.id&&w.t===i.id&&w.p===i.pin))return false;
  change(()=>{S.wires=S.wires.filter(w=>!(w.t===i.id&&w.p===i.pin));S.wires.push({id:S.nid++,f:o.id,t:i.id,p:i.pin});});
  return true;
}
function autoConnect(o,bid){ // Leitung auf Bausteinkörper fallen lassen → erster freier Eingang
  const b=byId(bid);if(!b||bid===o.id)return;const n=b.n??TYPES[b.t].n;
  const ao=isAnaOut(byId(o.id).t);
  for(let i=0;i<n;i++){if(!wireIn.get(bid+':'+i)&&isAnaIn(b.t,i)===ao){tryConnect(o,{kind:'pin-in',id:bid,pin:i});return;}}
  toast('Alle Eingänge dieses Bausteins sind belegt.');
}
const pop=$('#pop');
function showPinPop(me,x,y){
  const b=byId(me.id);const w=wireIn.get(me.id+':'+me.pin);const neg=b.neg&&b.neg[me.pin];
  let h=isAnaIn(b.t,me.pin)?'':`<button data-a="neg">${neg?'◯ Negierung entfernen':'⦾ Eingang negieren'}</button>`;
  if(w)h+=`<button data-a="cut">✂ Verbindung lösen</button>`;
  h+=`<button data-a="from">↦ Von hier aus verbinden</button><button data-a="x">Abbrechen</button>`;
  pop.innerHTML=h;pop.classList.add('show');
  const pw=pop.offsetWidth,ph=pop.offsetHeight;
  pop.style.left=Math.min(window.innerWidth-pw-6,Math.max(6,x+8))+'px';pop.style.top=Math.min(window.innerHeight-ph-6,Math.max(6,y+8))+'px';
  pop.querySelectorAll('button').forEach(bt=>bt.onclick=()=>{
    const a=bt.dataset.a;hidePop();
    if(a==='neg')change(()=>{b.neg=b.neg||[false,false,false,false];b.neg[me.pin]=!b.neg[me.pin];});
    if(a==='cut')change(()=>{S.wires=S.wires.filter(x=>x!==w&&x.id!==w.id);});
    if(a==='from'){pending=me;setHint('Eingang gewählt – tippe jetzt auf einen <b>Ausgang</b> (rechte Seite eines Bausteins).');render();}
  });
}
function hidePop(){pop.classList.remove('show');}
function setHint(t){const hb=$('#hintbar');if(t){hb.innerHTML=t;hb.classList.add('show');}else hb.classList.remove('show');}

/* ================= Auswahlleiste ================= */
function updSel(){
  const sb=$('#selbar');
  if(mode!=='edit'||!sel){sb.classList.remove('show');return;}
  let h='';
  if(sel.block){
    const b=byId(sel.block);if(!b){sel=null;sb.classList.remove('show');return;}
    const T=TYPES[b.t];
    h+=`<span class="cap">${isGF(b.t)?'B'+String(b.num).padStart(3,'0')+' ':''}${b.addr||T.name}</span>`;
    if(T.par)h+=`<button class="sb" data-a="par">⚙ Parameter</button>`;
    if(T.min){h+=`<button class="sb" data-a="nm">− Eingang</button><button class="sb" data-a="np">+ Eingang</button>`;}
    h+=`<button class="sb" data-a="info">ⓘ Info</button><button class="sb" data-a="copy">⧉ Kopieren</button><button class="sb" data-a="dup">⧉ Duplizieren</button><button class="sb del" data-a="del">🗑 Löschen</button>`;
  }else if(sel.multi){
    h+=`<span class="cap">${sel.multi.length} Bausteine</span><button class="sb" data-a="copy">⧉ Kopieren</button><button class="sb" data-a="dup">⧉ Duplizieren</button><button class="sb del" data-a="del">🗑 Löschen</button><button class="sb" data-a="unsel">✕</button>`;
  }else if(sel.wire){
    const w=S.wires.find(x=>x.id===sel.wire);if(!w){sel=null;sb.classList.remove('show');return;}
    const r=routePts(w);const long=r&&r.c.length>1;
    h+=`<span class="cap">Leitung</span><button class="sb" data-a="wauto">↺ Automatisch</button>`;
    h+=long?`<button class="sb" data-a="wless">− Umweg</button>`:`<button class="sb" data-a="wmore">＋ Umweg</button>`;
    h+=`<button class="sb del" data-a="delw">🗑 Löschen</button>`;
  }
  sb.innerHTML=h;sb.classList.add('show');
  sb.querySelectorAll('.sb').forEach(bt=>bt.onclick=()=>selAction(bt.dataset.a));
}
function selIds(){return !sel?[]:sel.multi?sel.multi.slice():sel.block?[sel.block]:[];}
function setMulti(ids){sel=ids.length>1?{multi:ids}:ids.length===1?{block:ids[0]}:null;}
function copySel(){const ids=new Set(selIds());if(!ids.size)return false;
  CB={blocks:JSON.parse(JSON.stringify(S.blocks.filter(b=>ids.has(b.id)))),wires:JSON.parse(JSON.stringify(S.wires.filter(w=>ids.has(w.f)&&ids.has(w.t))))};
  pasteN=0;updFabs();return true;}
function pasteCB(){
  if(!CB||mode!=='edit')return;pasteN++;const off=30*pasteN;const map=new Map();const newIds=[];let dropped=0;
  change(()=>{
    const usedQ=new Set(S.blocks.filter(b=>b.t==='Q'||b.t==='M').map(b=>b.addr));
    CB.blocks.forEach(o=>{const b=JSON.parse(JSON.stringify(o));
      if(b.t==='Q'||b.t==='M'){const L=b.t==='Q'?QADDR:MADDR;if(usedQ.has(b.addr)){const f=L.find(a=>!usedQ.has(a));if(!f){dropped++;return;}b.addr=f;}usedQ.add(b.addr);}
      b.id=S.nid++;b.x+=off;b.y+=off;if(isGF(b.t))b.num=S.num++;map.set(o.id,b.id);S.blocks.push(b);newIds.push(b.id);});
    CB.wires.forEach(o=>{if(!map.has(o.f)||!map.has(o.t))return;const w=JSON.parse(JSON.stringify(o));w.id=S.nid++;w.f=map.get(o.f);w.t=map.get(o.t);
      if(w.c)w.c=w.c.map((v,i)=>v+off);S.wires.push(w);});
    setMulti(newIds);
  });
  toast(`${newIds.length} Baustein(e) eingefügt`+(dropped?` – ${dropped} Ausgang/Merker weggelassen (alle Adressen schon belegt).`:'.'));
}
function updFabs(){$('#fabPaste').classList.toggle('hide',!CB||mode!=='edit');$('#fabBox').classList.toggle('on',boxMode);$('#fabBox').classList.toggle('hide',mode!=='edit');}
function selAction(a){
  if(a==='copy'){if(copySel())toast('Kopiert – mit 📋 (rechts unten) oder Strg+V einfügen.');return;}
  if(a==='dup'){if(copySel())pasteCB();return;}
  if(a==='unsel'){sel=null;render();updSel();return;}
  if(a==='del')delSel();
  if(a==='delw')delSel();
  if(sel&&sel.wire&&(a==='wauto'||a==='wmore'||a==='wless')){
    const w=S.wires.find(x=>x.id===sel.wire);if(!w)return;const e=wireEnds(w);
    change(()=>{
      if(a==='wauto')delete w.c;
      if(a==='wmore'){const c=routePts(w).c;const x1=c[0];w.c=[x1,snap(Math.max(e.a.y,e.b.y)+40),snap(e.b.x-20)];}
      if(a==='wless'){w.c=[snap((e.a.x+e.b.x)/2)];}
    });
    if(a!=='wauto')toast('Ziehe die Abschnitte an den Griffen ■, um die Leitung zu verlegen.');
    return;
  }
  const b=sel&&sel.block&&byId(sel.block);if(!b)return;
  if(a==='par')showParams(b);
  if(a==='info')showInfo(b.t);
  if(a==='np'||a==='nm'){const T=TYPES[b.t];const n=(b.n??T.n)+(a==='np'?1:-1);
    if(n<T.min||n>T.max){toast(`Dieser Baustein hat ${T.min}–${T.max} Eingänge.`);return;}
    change(()=>{b.n=n;S.wires=S.wires.filter(w=>!(w.t===b.id&&w.p>=n));b.neg[n]=b.neg[n]&&false;});}
}
function delSel(){
  if(!sel)return;
  if(sel.block||sel.multi){const ids=new Set(selIds());change(()=>{S.blocks=S.blocks.filter(b=>!ids.has(b.id));S.wires=S.wires.filter(w=>!ids.has(w.f)&&!ids.has(w.t));sel=null;});}
  else if(sel.wire){const id=sel.wire;change(()=>{S.wires=S.wires.filter(w=>w.id!==id);sel=null;});}
}

