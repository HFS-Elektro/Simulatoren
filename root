    const ptxt=parText(b,isSim);if(ptxt)h+=`<text class="${isSim?'pval'+(b.t==='CTR'||TIMED.includes(b.t)?' d':''):'ptag'}" x="${b.x}" y="${b.y+g.h+11}">${ptxt}</text>`;
    // Anschlüsse
