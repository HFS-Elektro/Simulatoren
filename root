function wSolve(){
  const wd=S.wd,hw=S.hw;
  if(!W.power){Object.assign(W,{f:null,src:new Map(),coil:{},coilN:{},lamp:{},sp:{},q:{},lp:false,term:{},ain:{},mv:{},mot:{},anaNet:new Map()});return;}
  const par=new Map();
  const f=k=>{let r=k,p;while((p=par.get(r))!==undefined&&p!==r)r=p;let x=k;while((p=par.get(x))!==undefined&&p!==r){par.set(x,r);x=p;}return r;};
  const u=(a,b)=>{const x=f(a),y=f(b);if(x!==y)par.set(x,y);};
  let coil={...W.coil},sp={...W.sp},q={...W.q},lamp={},lp=false,term={},ain={},mv=W.mv||{},anaNet=new Map(),osc=false,B=null;
  const wasLp=W.lp,SRC=wSrc();
  // Netze bilden; skip = Schutzschalter, der probeweise als offen gilt
  const build=skip=>{par.clear();
    wd.wires.forEach(w=>u(ekey(w.a),ekey(w.b)));
    wd.comps.forEach(c=>{const K=WK[c.k];
      if(K.ct){if(c.id!==skip&&wClosed(c))wPoles(K).forEach(([a,b])=>u(c.id+':'+a,c.id+':'+b));}
      else if(c.k==='DS'){if(sp[c.id]&&W.act[c.id])u(c.id+':+',c.id+':O');}});
    [1,2,3,4].forEach(i=>{if(q['Q'+i])u('logo:Q'+i+'a','logo:Q'+i+'b');});
    const m=new Map();let short=false;
    SRC.forEach(([k,p])=>{const r=f(k),o=m.get(r);if(o&&o!==p&&!(isNeuP(o)&&isNeuP(p)))short=true;if(!o||isHotP(p))m.set(r,p);});
    return {m,short};};
  for(let it=0;;it++){
    W.coilN={};wd.comps.forEach(c=>{if(c.k==='K'&&coil[c.id])W.coilN[nkey(c)]=true;});
    B=build(null);
    if(B.short){ // Kurzschluss → zuerst Motorschutzschalter, dann Leitungsschutzschalter im Fehlerkreis, sonst Vorsicherung
      const cand=wd.comps.filter(c=>WK[c.k].brk&&wClosed(c)).sort((a,b)=>WK[b.k].brk-WK[a.k].brk);
      const hit=cand.find(c=>!build(c.id).short);
      if(hit){W.brk[hit.id]='trip';toast(`⚡ Kurzschluss! ${hit.name||''} (${WK[hit.k].n}) hat ausgelöst. Spannung aus, Fehler beheben, Schalter antippen = wieder ein.`);wSolve();return;}
      W.power=false;W.trip=true;clearInterval(wTimer);wTimer=null;wsim=newSim();document.body.classList.remove('wlive');
      toast(S.wd.main?'⚡ Kurzschluss! Kein Schutzschalter im Fehlerkreis – die Vorsicherung -F1 hat ausgelöst, alles ist spannungslos.':'⚡ Kurzschluss! L und N sind direkt verbunden – die Sicherung -F1 hat ausgelöst.');
      wSolve();return;
    }
    const P=k=>B.m.get(f(k))||null;
    const both=(a,b)=>{const x=P(a),y=P(b);return !!x&&!!y&&x!==y&&(isHotP(x)||isHotP(y));};
    const nc={},ns={};lamp={};
    wd.comps.forEach(c=>{
      if(c.k==='K')nc[c.id]=both(c.id+':A1',c.id+':A2');
      if(c.k==='P')lamp[c.id]=both(c.id+':X1',c.id+':X2');
      if(c.k==='DS'||c.k==='AS')ns[c.id]=isHotP(P(c.id+':+'))&&isNeuP(P(c.id+':-'))&&(c.k==='DS'||hw==='24');});
    lp=hw==='24'?(P('logo:P1')==='P24'&&P('logo:P2')==='M24'):both('logo:P1','logo:P2');
    anaNet=new Map();
    wd.comps.forEach(c=>{if(c.k==='AS'&&ns[c.id]){const r=f(c.id+':U');if(!B.m.has(r))anaNet.set(r,W.ana[c.id]??5);}});
    term={};ain={};
    const inHot=p=>hw==='24'?p==='P24':isHotP(p)&&p!=='P24';
    IADDR.forEach(a=>{const r=f('logo:'+a);let v=lp&&inHot(B.m.get(r))?1:0;if(lp&&hw==='24'&&anaNet.has(r)&&anaNet.get(r)>=8)v=1;term[a]=v;});
    if(hw==='24')AIADDR.forEach(a=>{const r=f('logo:'+AIPIN[a]);let V=0;if(lp){if(B.m.get(r)==='P24')V=24;else if(anaNet.has(r))V=anaNet.get(r);}ain[a]=Math.max(0,Math.min(1000,Math.round(V*100)));});
