/* ---------- Prüfen ---------- */
function checkProgram(){
  buildIndex();const res=[];const bn=b=>isGF(b.t)?'B'+String(b.num).padStart(3,'0')+' ('+TYPES[b.t].name+')':b.addr;
  const qs={};S.blocks.filter(b=>b.t==='Q').forEach(b=>{qs[b.addr]=(qs[b.addr]||0)+1;});
  Object.entries(qs).forEach(([a,c])=>{if(c>1)res.push(['✖',`Ausgang ${a} ist ${c}× im Programm. Jeder Ausgang darf nur einmal angesteuert werden.`]);});
  const ms={};S.blocks.filter(b=>b.t==='M').forEach(b=>{ms[b.addr]=(ms[b.addr]||0)+1;});
  Object.entries(ms).forEach(([a,c])=>{if(c>1)res.push(['✖',`Merker ${a} ist ${c}× im Programm. Jeder Merker darf nur einmal beschrieben werden.`]);});
  if(!S.blocks.some(b=>b.t==='Q'))res.push(['⚠','Es gibt noch keinen Ausgang Q – ohne Ausgang passiert an der Anlage nichts.']);
  S.blocks.forEach(b=>{
    const n=b.n??TYPES[b.t].n;const open=[];for(let i=0;i<n;i++)if(!wireIn.get(b.id+':'+i))open.push(i);
    if(b.t==='Q'&&open.length)res.push(['⚠',`Ausgang ${b.addr} hat keine Verbindung am Eingang.`]);
    if((b.t==='AND'||b.t==='NAND')&&open.length){if(open.length===n)res.push(['⚠',`${bn(b)}: Kein Eingang verbunden.`]);
      else res.push(['ℹ',`${bn(b)}: Eingang ${open.map(i=>i+1).join(', ')} offen – zählt wie im Original als 1.`]);}
    if((b.t==='OR'||b.t==='NOR')&&open.length){if(open.length===n)res.push(['⚠',`${bn(b)}: Kein Eingang verbunden.`]);
      else res.push(['ℹ',`${bn(b)}: Eingang ${open.map(i=>i+1).join(', ')} offen – zählt als 0.`]);}
    if(b.t==='NOT'&&open.length)res.push(['⚠',`${bn(b)}: Eingang nicht verbunden.`]);
    if(b.t==='M'&&open.length&&b.addr!=='M8')res.push(['⚠',`Merker ${b.addr} hat keine Verbindung am Eingang – er ist immer 0.`]);
    if(['XOR','EDGP','EDGN'].includes(b.t)&&open.length)res.push(['⚠',`${bn(b)}: Eingang ${open.map(i=>i+1).join(', ')} nicht verbunden.`]);
    if(['TOGG','TONR','WIPE','BLINK','STAIR','COMF'].includes(b.t)&&open.includes(0))res.push(['⚠',`${bn(b)}: Eingang ${TYPES[b.t].pins[0]} nicht verbunden – der Baustein schaltet nie.`]);
    if(b.t==='RS'||b.t==='SR'){
      if(open.includes(0))res.push(['⚠',`${bn(b)}: Setzeingang ${TYPES[b.t].pins[0]} nicht verbunden – der Speicher kann nie einschalten.`]);
      if(open.includes(1))res.push(['✖',`${bn(b)}: Rücksetzeingang ${TYPES[b.t].pins[1]} nicht verbunden – einmal gesetzt, geht der Ausgang nie wieder aus!`]);
    }
    if(b.t==='AI'&&S.hw==='230')res.push(['✖',`${b.addr}: Die LOGO! 230 V hat keine Analogeingänge. Stelle links „24 V“ ein oder nutze einen Digitaleingang.`]);
    if((b.t==='TON'||b.t==='TOF')&&open.includes(0))res.push(['⚠',`${bn(b)}: Trg nicht verbunden – die Zeit startet nie.`]);
    if(b.t==='CTR'&&open.includes(1))res.push(['⚠',`${bn(b)}: Cnt nicht verbunden – es wird nie gezählt.`]);
    if(b.t==='CTR'&&open.includes(0))res.push(['ℹ',`${bn(b)}: R nicht verbunden – der Zähler lässt sich nur über ⟲ Neustart zurücksetzen.`]);
    if(['ATH','ACMP','AMP'].includes(b.t)&&open.length)res.push(['⚠',`${bn(b)}: Analogeingang ${open.map(i=>TYPES[b.t].pins[i]).join(', ')} nicht verbunden.`]);
    if(isGF(b.t)&&b.t!=='AMP'&&!S.wires.some(w=>w.f===b.id))res.push(['ℹ',`${bn(b)}: Ausgang wird nicht weiterverwendet.`]);
  });
  const usedQ=S.blocks.filter(b=>b.t==='Q').map(b=>b.addr);
  if(usedQ.includes('Q1')&&usedQ.includes('Q2')){
    // Testen, ob Q1 und Q2 durch reine Eingangskombination gleichzeitig 1 werden
    const ins=[...new Set(S.blocks.filter(b=>b.t==='I').map(b=>b.addr))].sort();
    if(ins.length<=8){let both=false;for(let m=0;m<(1<<ins.length)&&!both;m++){const ctx={term:{},mem:{},val:{},ain:aRaw,now:0,stat:true};ins.forEach((a,i)=>ctx.term[a]=(m>>(ins.length-1-i))&1);settle(ctx);const q=qVals(ctx);if(q.Q1&&q.Q2)both=true;}
      if(both)res.push(['⚠','Q1 und Q2 können gleichzeitig 1 werden. Bei einer Wendeschaltung fehlt dann die Verriegelung!']);}
  }
  return res;
}
