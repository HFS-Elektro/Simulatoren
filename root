    $('#pOk').onclick=()=>{const a=$('#pAddr').value;
      if(a!==b.addr&&S.blocks.some(x=>x.t==='M'&&x.addr===a)){toast(`${a} ist schon im Programm verwendet.`);return;}
      change(()=>{b.addr=a;S.minfo[a].txt=$('#pTxt').value.trim();});closeModal();};
