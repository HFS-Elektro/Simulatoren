const PINR=COARSE?15:10;
Object.values(TYPES).forEach(T=>T.out=true);

/* ================= Zustand ================= */
const KEY='hfs_logo_sim_v1';
function fresh(){
  const g={},q={};
  IADDR.forEach(a=>g[a]={name:'',art:'T',k:'NO',txt:''});
  QADDR.forEach(a=>q[a]={name:'',txt:''});
  return migrate({v:1,blocks:[],wires:[],geber:g,qinfo:q,nid:1,num:1});
}
/* Prüf-Nr.: vierstellige Nummer dieses Browsers (bleibt, solange der Browser-Speicher nicht gelöscht wird) */
let DEV=null;try{DEV=localStorage.getItem('hfs_logo_dev');}catch(e){}
if(!DEV||!/^\d{4}$/.test(DEV)){DEV=String(1000+Math.floor(Math.random()*9000));try{localStorage.setItem('hfs_logo_dev',DEV);}catch(e){}}
function migrate(o){
