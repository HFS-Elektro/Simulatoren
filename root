/* ================= Bibliothek ================= */
function buildLib(){
  const groups=[['Ko – Klemmen',k=>TYPES[k].cat==='Ko'],['GF – Grund&shy;funktionen',k=>TYPES[k].cat==='GF'],['SF – Flanken',k=>TYPES[k].grp==='E'],
    ['SF – Speicher',k=>TYPES[k].grp==='S'],['SF – Zeiten',k=>TYPES[k].grp==='T'],['SF – Licht',k=>TYPES[k].grp==='L'],['SF – Zähler',k=>TYPES[k].grp==='C'],['SF – Analog',k=>TYPES[k].grp==='A']];
  const order=['I','AI','Q','M','HI','LO','AND','OR','NOT','NAND','NOR','XOR','EDGP','EDGN','RS','SR','TOGG','TON','TOF','TONR','WIPE','BLINK','STAIR','COMF','CTR','ATH','ACMP','AMP'];
  let h=`<div class="hwsel">LOGO!-Variante${segHtml('hwSeg',[['230','230 V'],['24','24 V']],S.hw)}</div>`;
  groups.forEach(([title,f])=>{
    h+=`<div class="lgrp">${title}</div>`;
    order.filter(f).forEach(k=>{const T=TYPES[k];
      const sym=k==='I'?'I':k==='Q'?'Q':k==='AI'?'AI':k==='M'?'M':T.sym;
      const dis=k==='AI'&&S.hw==='230';
      h+=`<button class="litem${dis?' dis':''}" data-t="${k}" title="${T.name} (${T.en})"><span class="sym${T.negOut?' neg':''}"${sym.length>2?' style="font-size:11px"':''}>${sym}</span><span class="nm">${T.ln||T.name}</span></button>`;
    });
  });
  $('#lib').innerHTML=h;
  $('#lib').querySelectorAll('.litem').forEach(el=>el.addEventListener('click',()=>addBlock(el.dataset.t)));
  document.querySelectorAll('#hwSeg button').forEach(bt=>bt.onclick=()=>setHw(bt.dataset.v));
}
function setHw(v){
  if(v===S.hw)return;
  if(W.power){toast('Erst die Spannung ausschalten – die LOGO! wird nicht unter Spannung getauscht.');buildLib();if(typeof buildWlib==='function')buildWlib();return;}
  const had=!!S.lmem;
  change(()=>{S.hw=v;S.lmem=null;});buildLib();if(tab==='wire')buildWlib();
  if(v==='230'&&S.blocks.some(b=>b.t==='AI'))toast('⚠ Die 230-V-LOGO! hat keine Analogeingänge – die AI-Bausteine funktionieren dort nicht.');
  else toast((v==='24'?'LOGO! 24 V: Analogeingänge AI1–AI4 an I7, I8, I1, I2 verfügbar.':'LOGO! 230 V: keine Analogeingänge.')+(had?' Andere LOGO! eingebaut – ihr Programmspeicher ist leer.':''));
}
function addBlock(t){
  if(mode!=='edit')return;
  const T=TYPES[t];
  const b={id:S.nid++,t,x:0,y:0};
  if(t==='I'){const used=new Set(S.blocks.filter(x=>x.t==='I').map(x=>x.addr));b.addr=IADDR.find(a=>!used.has(a))||'I1';}
  if(t==='Q'){const used=new Set(S.blocks.filter(x=>x.t==='Q').map(x=>x.addr));const a=QADDR.find(a=>!used.has(a));
    if(!a){toast('Alle Ausgänge Q1–Q4 sind schon im Programm.');S.nid--;return;}b.addr=a;}
  if(t==='M'){const used=new Set(S.blocks.filter(x=>x.t==='M').map(x=>x.addr));const a=MADDR.find(a=>!used.has(a));
    if(!a){toast('Alle Merker M1–M8 sind schon im Programm.');S.nid--;return;}b.addr=a;}
  if(t==='AI'){if(S.hw==='230'){toast('Die 230-V-LOGO! hat keine Analogeingänge. Stelle oben links „24 V“ ein.');S.nid--;return;}
    const used=new Set(S.blocks.filter(x=>x.t==='AI').map(x=>x.addr));b.addr=AIADDR.find(a=>!used.has(a))||'AI1';}
  if(defPar(t))b.p=defPar(t);
  if(T.n>0){b.n=T.n;b.neg=[false,false,false,false];}
  const r=svg.getBoundingClientRect();
  const c=toWorld(r.left+r.width*(t==='Q'?0.7:(t==='I'||t==='AI')?0.25:0.47),r.top+r.height*0.35);
  let x=snap(c.x),y=snap(c.y);
  b.x=x;b.y=y;b.n=b.n??T.n;const gb=geom(b);
  const hit=()=>S.blocks.find(o=>{const go=geom(o);return o.x<b.x+gb.w+50&&o.x+go.w+50>b.x&&o.y<b.y+gb.h+38&&o.y+go.h+38>b.y;});
  let guard=0,o;while((o=hit())&&guard++<40){b.y=snap(o.y+geom(o).h+40);if(guard%8===0){b.x+=100;b.y=y;}}
  change(()=>{if(isGF(t))b.num=S.num++;S.blocks.push(b);sel={block:b.id};});
  pending=null;setHint();
  const nm=isGF(t)?`B${String(b.num).padStart(3,'0')} ${T.name}`:(b.addr||T.name);
  toast(`${nm} eingefügt – zum Verschieben ziehen`);
}

/* ================= Zeiger / Touch ================= */
function toWorld(cx,cy){const r=svg.getBoundingClientRect();return {x:(cx-r.left-view.tx)/view.s,y:(cy-r.top-view.ty)/view.s};}
const ptrs=new Map();let act=null;
const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y),mid=(a,b)=>({x:(a.x+b.x)/2,y:(a.y+b.y)/2});
svg.addEventListener('contextmenu',e=>e.preventDefault());
svg.addEventListener('pointerdown',e=>{
  try{svg.setPointerCapture(e.pointerId);}catch(_){}
  ptrs.set(e.pointerId,{x:e.clientX,y:e.clientY});
  hidePop();
  if(ptrs.size===2){
    if(act&&act.lp)clearTimeout(act.lp);
    if(act&&act.k==='actuate')geberUp(act.addr);
    if(act&&act.k==='drag'&&act.moved){/* Verschieben übernehmen */pushUndo(act.snap);save();}
    const [p1,p2]=[...ptrs.values()];
    act={k:'pinch',d0:dist(p1,p2),s0:view.s,m0:mid(p1,p2),tx0:view.tx,ty0:view.ty};return;
  }
  if(ptrs.size>2)return;
  const tgt=e.target.closest('[data-kind]');const kind=tgt?tgt.dataset.kind:'bg';const id=tgt?+tgt.dataset.id:null;
  const w=toWorld(e.clientX,e.clientY);
  const base={sx:e.clientX,sy:e.clientY,moved:false,pid:e.pointerId};
  if(mode==='sim'){
    if(kind==='block'){const b=byId(id);if(b&&b.t==='I'){act={...base,k:'actuate',addr:b.addr};geberDown(b.addr);return;}}
    act={...base,k:'pan',tx0:view.tx,ty0:view.ty};return;
  }
  if(kind==='pin-out'||kind==='pin-in'){act={...base,k:'wire',kind,id,pin:+(tgt.dataset.pin||0),cur:w};return;}
  if(kind==='block'&&(boxMode||e.shiftKey)&&!(sel&&sel.multi&&sel.multi.includes(id))){act={...base,k:'toggle',id};return;}
  if(kind==='block'){const b=byId(id);
    act={...base,k:'drag',id,ox:w.x-b.x,oy:w.y-b.y,snap:JSON.stringify(S)};
    if(sel&&sel.multi&&sel.multi.includes(id)){act.grp=sel.multi.map(i=>{const x=byId(i);return {id:i,x:x.x,y:x.y};});act.w0=w;
      const set=new Set(sel.multi);act.gw=S.wires.filter(x=>x.c&&set.has(x.f)&&set.has(x.t)).map(x=>({w:x,c:x.c.slice()}));}
    const me=act;
    act.lp=setTimeout(()=>{if(act===me&&!me.moved){act=null;sel={block:id};render();updSel();showInfo(b.t);}},650);
    return;}
  if(kind==='seg'){act={...base,k:'seg',id,ix:+tgt.dataset.ix,snap:JSON.stringify(S)};return;}
  if(boxMode||e.shiftKey){act={...base,k:'box',w0:w,w1:w};return;}
  act={...base,k:'pan',tx0:view.tx,ty0:view.ty};
});
svg.addEventListener('pointermove',e=>{
  if(!ptrs.has(e.pointerId)){
    if(pending&&e.pointerType!=='touch'){pendCur=toWorld(e.clientX,e.clientY);render();}
    return;
  }
  ptrs.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(!act)return;
  if(act.k==='pinch'){
    if(ptrs.size<2)return;
    const [p1,p2]=[...ptrs.values()];const r=svg.getBoundingClientRect();
    const s=Math.min(3,Math.max(0.3,act.s0*dist(p1,p2)/act.d0));
    const wx=(act.m0.x-r.left-act.tx0)/act.s0,wy=(act.m0.y-r.top-act.ty0)/act.s0;const m=mid(p1,p2);
    view.s=s;view.tx=m.x-r.left-wx*s;view.ty=m.y-r.top-wy*s;applyView();return;
  }
  if(act.pid!==e.pointerId)return;
  const dx=e.clientX-act.sx,dy=e.clientY-act.sy;
  if(!act.moved&&Math.hypot(dx,dy)>(e.pointerType==='touch'?9:5)){act.moved=true;if(act.lp)clearTimeout(act.lp);}
  if(!act.moved)return;
  if(act.k==='pan'){view.tx=act.tx0+dx;view.ty=act.ty0+dy;applyView();}
  else if(act.k==='drag'&&act.grp){const w=toWorld(e.clientX,e.clientY);const dx2=snap(w.x-act.w0.x),dy2=snap(w.y-act.w0.y);
    act.grp.forEach(g=>{const b=byId(g.id);if(b){b.x=g.x+dx2;b.y=g.y+dy2;}});
    act.gw.forEach(o=>{o.w.c=o.c.map((v,i)=>v+(i%2===0?dx2:dy2));});render();}
  else if(act.k==='drag'){const w=toWorld(e.clientX,e.clientY);const b=byId(act.id);b.x=snap(w.x-act.ox);b.y=snap(w.y-act.oy);render();}
  else if(act.k==='box'){act.w1=toWorld(e.clientX,e.clientY);render();}
  else if(act.k==='wire'){act.cur=toWorld(e.clientX,e.clientY);render();}
  else if(act.k==='seg'&&act.ix>=0){const w=S.wires.find(x=>x.id===act.id);if(!w)return;
    if(!w.c){computeBus();w.c=routePts(w).c.slice();}
    const p=toWorld(e.clientX,e.clientY);w.c[act.ix]=snap(act.ix%2===0?p.x:p.y);sel={wire:w.id};render();}
});
function ptrUp(e){
  ptrs.delete(e.pointerId);
  if(!act)return;
  if(act.k==='pinch'){if(ptrs.size<2)act=null;return;}
  if(act.pid!==e.pointerId)return;
  const a=act;act=null;if(a.lp)clearTimeout(a.lp);
  if(a.k==='actuate'){geberUp(a.addr);return;}
  if(a.k==='pan'){if(!a.moved&&mode==='edit'){if(pending){pending=null;pendCur=null;setHint();}sel=null;render();updSel();}return;}
  if(a.k==='box'){
    if(a.moved){const x0=Math.min(a.w0.x,a.w1.x),x1=Math.max(a.w0.x,a.w1.x),y0=Math.min(a.w0.y,a.w1.y),y1=Math.max(a.w0.y,a.w1.y);
      const ids=S.blocks.filter(b=>{const g=geom(b);return b.x<x1&&b.x+g.w>x0&&b.y<y1&&b.y+g.h>y0;}).map(b=>b.id);
      setMulti(ids);}
    else{sel=null;}
    render();updSel();return;}
  if(a.k==='toggle'){let ids=sel?(sel.multi?sel.multi.slice():sel.block?[sel.block]:[]):[];
    ids=ids.includes(a.id)?ids.filter(i=>i!==a.id):ids.concat(a.id);setMulti(ids);render();updSel();return;}
  if(a.k==='drag'){if(a.moved){pushUndo(a.snap);save();updProj();}else if(boxMode&&sel&&sel.multi){setMulti(sel.multi.filter(i=>i!==a.id));}else{sel={block:a.id};}render();updSel();return;}
  if(a.k==='seg'){if(a.moved&&a.ix>=0){pushUndo(a.snap);save();updProj();}sel={wire:a.id};render();updSel();if(!a.moved&&a.ix>=0&&!a.hinted){}return;}
  if(a.k==='wire'){
    const me={kind:a.kind,id:a.id,pin:a.pin};
    if(a.moved){
      const el=document.elementFromPoint(e.clientX,e.clientY);const t=el&&el.closest&&el.closest('[data-kind]');
      if(t&&(t.dataset.kind==='pin-in'||t.dataset.kind==='pin-out'))tryConnect(me,{kind:t.dataset.kind,id:+t.dataset.id,pin:+(t.dataset.pin||0)});
      else if(t&&t.dataset.kind==='block'&&me.kind==='pin-out')autoConnect(me,+t.dataset.id);
      render();return;
    }
    if(pending&&pending.kind!==me.kind){tryConnect(pending,me);pending=null;pendCur=null;setHint();render();return;}
    if(me.kind==='pin-out'){pending=me;setHint('Ausgang gewählt – tippe jetzt auf einen <b>Eingang</b> (linke Seite eines Bausteins). Tippe ins Leere zum Abbrechen.');sel=null;updSel();render();return;}
    showPinPop(me,e.clientX,e.clientY);
  }
}
svg.addEventListener('pointerup',ptrUp);svg.addEventListener('pointercancel',ptrUp);
svg.addEventListener('wheel',e=>{e.preventDefault();
  if(e.ctrlKey||e.metaKey){zoomAt(e.clientX,e.clientY,Math.exp(-e.deltaY*(e.deltaMode?0.05:0.0025)));}
  else if(e.deltaMode===0&&Math.abs(e.deltaY)<50&&!e.shiftKey){view.tx-=e.deltaX;view.ty-=e.deltaY;applyView();}
  else zoomAt(e.clientX,e.clientY,e.deltaY<0?1.12:1/1.12);},{passive:false});
/* Safari (iPad): eigenes Seiten-Zoomen verhindern; Trackpad-Pinch auf der Zeichenfläche zoomt die Ansicht */
let gs0=1;
['gesturestart','gesturechange','gestureend'].forEach(t=>document.addEventListener(t,e=>{
  e.preventDefault();
  if(!svg.contains(e.target)&&e.target!==svg)return;
  if(ptrs.size>=2)return; // Finger-Pinch läuft bereits über Pointer-Events
  if(t==='gesturestart')gs0=1;
  else if(t==='gesturechange'){zoomAt(e.clientX||innerWidth/2,e.clientY||innerHeight/2,e.scale/gs0);gs0=e.scale;}
},{passive:false}));
/* iOS: Lupe, Markieren und Scrollen beim langen Drücken auf Zeichenfläche verhindern */
svg.addEventListener('touchstart',e=>{e.preventDefault();},{passive:false});
svg.addEventListener('touchmove',e=>{e.preventDefault();},{passive:false});
document.addEventListener('dblclick',e=>e.preventDefault());
function zoomAt(cx,cy,f){const r=svg.getBoundingClientRect();const w=toWorld(cx,cy);view.s=Math.min(3,Math.max(0.3,view.s*f));
  view.tx=cx-r.left-w.x*view.s;view.ty=cy-r.top-w.y*view.s;applyView();}
function fit(){
  if(!S.blocks.length){view={tx:60,ty:50,s:UIZ[uiDev]||1};applyView();return;}
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
  S.blocks.forEach(b=>{const g=geom(b);x0=Math.min(x0,b.x-30);y0=Math.min(y0,b.y-25);x1=Math.max(x1,b.x+g.w+30);y1=Math.max(y1,b.y+g.h+25);});
  const r=svg.getBoundingClientRect();const s=Math.min(1.6*(UIZ[uiDev]||1),Math.max(0.3,Math.min(r.width/(x1-x0),r.height/(y1-y0))*0.92));
  view.s=s;view.tx=(r.width-(x1-x0)*s)/2-x0*s;view.ty=(r.height-(y1-y0)*s)/2-y0*s;applyView();
}
$('#zIn').onclick=()=>{const r=svg.getBoundingClientRect();zoomAt(r.left+r.width/2,r.top+r.height/2,1.2);};
$('#zOut').onclick=()=>{const r=svg.getBoundingClientRect();zoomAt(r.left+r.width/2,r.top+r.height/2,1/1.2);};
