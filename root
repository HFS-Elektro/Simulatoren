#hintbar{position:absolute;left:10px;bottom:10px;max-width:calc(100% - 80px);background:var(--card);border:1px solid var(--sel);color:var(--ink);
  border-radius:9px;padding:7px 10px;box-shadow:var(--shadow);display:none;font-size:13px}
