  if(view!=='auf'&&view!=='sch'){const par=new Map(),f=x=>{while(par.has(x)&&par.get(x)!==x)x=par.get(x);return x},deg=new Set();
    for(const l of c.links)if(!l.core){deg.add(l.a);deg.add(l.b)}
    const used=c.links.filter(l=>!l.core||deg.has(l.a)||deg.has(l.b));for(const l of used){const a=f(l.a),b=f(l.b);if(a!==b)par.set(a,b)}
    const peR=new Set(),nR=new Set();for(const e of c.els)for(const t of TT(e)){const k=K(e,t.n);if(t.n==='PE'||(e.type==='pot'&&e.props.pot==='PE'))peR.add(f(k));if(['N','N1','N2'].includes(t.n)||(e.type==='pot'&&e.props.pot==='N'))nR.add(f(k))}
