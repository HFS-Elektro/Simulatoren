const TIMED=['TON','TOF','TONR','WIPE','BLINK','STAIR','COMF','EDGP','EDGN'];
const AIADDR=['AI1','AI2','AI3','AI4'];
const AIPIN={AI1:'I7',AI2:'I8',AI3:'I1',AI4:'I2'};
const isAnaOut=t=>!!TYPES[t].ao;
const isAnaIn=(t,i)=>!!(TYPES[t].ain&&TYPES[t].ain[i]);
const DEFR={min:0,max:1000,unit:'',dec:0};
const fmtN=(v,d)=>Number(v).toFixed(d??1).replace('.',',');
const bName=b=>isGF(b.t)?'B'+String(b.num).padStart(3,'0'):b.addr;
const isGF=t=>TYPES[t].cat!=='Ko';
