    if(!conn('logo:FE'))res.push(['⚠','Die Funktionserde FE (⏚) der LOGO! ist nicht angeschlossen – sie gehört an die PE-Schiene (EMV, keine Schutzmaßnahme).']);
    else if(fe===L||fe===N)res.push(['✖',`Die Funktionserde FE (⏚) der LOGO! liegt an ${fe===L?l1:l2} – sie darf nur mit PE verbunden werden!`]);
    else if(!pe.includes(fe))res.push(['⚠','Die Funktionserde FE (⏚) der LOGO! ist nicht mit der PE-Schiene verbunden.']); }
  IADDR.forEach(a=>{if(!S.blocks.some(b=>b.t==='I'&&b.addr===a))return;if(!conn('logo:'+a))res.push(['⚠',`Eingang ${a} wird im Programm benutzt, ist aber nicht angeschlossen.`]);});
  if(S.hw==='24')AIADDR.forEach(a=>{if(S.blocks.some(b=>b.t==='AI'&&b.addr===a)&&!conn('logo:'+AIPIN[a]))res.push(['⚠',`${a} (Klemme ${AIPIN[a]}) wird im Programm benutzt, ist aber nicht angeschlossen.`]);});
  QADDR.forEach((a,i)=>{if(!S.blocks.some(b=>b.t==='Q'&&b.addr===a))return;
    if(!conn('logo:'+a+'a')&&!conn('logo:'+a+'b'))res.push(['⚠',`Ausgang ${a} wird im Programm benutzt, aber an Klemme ${a}.1/${a}.2 ist nichts angeschlossen.`]);
    else{const na=net('logo:'+a+'a'),nb=net('logo:'+a+'b');if(na!==L&&nb!==L)res.push(['⚠',`Ausgang ${a}: Keine der beiden Klemmen (1/2) liegt an ${l1} – das Relais schaltet keine Spannung.`]);}});
  wd.comps.forEach(c=>{const K=WK[c.k];
    if(K.only&&S.hw!==K.only)res.push(['✖',`${nm(c)}: 0–10-V-Sensoren funktionieren nur an der LOGO! 24 V.`]);
    if(K.kq&&!wd.comps.some(o=>o.k==='K'&&nkey(o)===nkey(c)))res.push(['⚠',`${nm(c)}: Es gibt keine Schützspule mit dem Kennzeichen „${esc(c.name||'')}“ – diese Kontakte schalten nie.`]);
    if(K.ovl&&c.k!=='FRH'&&!wd.comps.some(o=>o.k==='FRH'&&nkey(o)===nkey(c)))res.push(['ℹ',`${nm(c)}: Im Hauptstromkreis fehlen die Hauptstrombahnen des Motorschutzrelais „${esc(c.name||'')}“.`]);
    if(K.poles||c.k==='M3'){const miss=K.T.filter(t=>!conn(c.id+':'+t[0])).map(t=>t[0]);if(miss.length)res.push(['⚠',`${nm(c)}: Klemme ${miss.join(', ')} ist nicht angeschlossen.`]);}
    if(c.k==='M3'&&conn(c.id+':PE')&&net(c.id+':PE')!==net('RPE')&&net(c.id+':PE')!==net('RSPE'))res.push(['✖',`${nm(c)}: PE ist nicht mit dem Schutzleiter PE verbunden – Gefahr bei Körperschluss!`]);
    if(K.ct&&!K.poles){const t0=c.id+':'+K.T[0][0],t1=c.id+':'+K.T[1][0];if(!conn(t0)||!conn(t1))res.push(['⚠',`${nm(c)}: Klemme ${!conn(t0)?K.T[0][0]:K.T[1][0]} ist nicht angeschlossen.`]);
      else{const toI=[t0,t1].some(t=>IADDR.some(a=>net(t)===net('logo:'+a)));const toL=[t0,t1].some(t=>net(t)===L);
        if(!toL&&toI)res.push(['⚠',`${nm(c)}: liegt an einem Eingang, bekommt aber keine Spannung von ${l1}.`]);}}
    if(c.k==='K'||c.k==='P'){const a=c.id+':'+K.T[0][0],b=c.id+':'+K.T[1][0];if(net(a)!==N&&net(b)!==N)res.push(['⚠',`${nm(c)}: Kein Anschluss an ${l2} – der Stromkreis ist nicht geschlossen.`]);
      if(net(a)===L&&net(b)===N||net(a)===N&&net(b)===L)res.push(['ℹ',`${nm(c)}: liegt direkt zwischen ${l1} und ${l2} – ist immer an (nicht über die LOGO! geschaltet).`]);}
    if(c.k==='DS'||c.k==='AS'){if(net(c.id+':+')!==L||net(c.id+':-')!==N)res.push(['⚠',`${nm(c)}: Versorgung fehlt (${wTermLbl(c,'+')} an ${l1}, ${wTermLbl(c,'-')} an ${l2}).`]);}});
  if(wd.comps.some(c=>c.k==='M3')&&!wd.comps.some(c=>c.k==='FRH'||c.k==='MSS'))res.push(['⚠','Der Motor hat keinen Überlastschutz (Motorschutzrelais oder Motorschutzschalter).']);
  if(wd.comps.some(c=>c.k==='KH')&&!wd.comps.some(c=>c.k==='LS3'||c.k==='MSS'))res.push(['⚠','Im Hauptstromkreis fehlt ein Kurzschlussschutz (Leitungsschutzschalter oder Motorschutzschalter).']);
  if(!S.lmem)res.push(['ℹ','In der LOGO! ist noch kein Programm. Zum Testen: Spannung EIN → Kabel einstecken → IP eingeben → Laden.']);
  else if(progChanged())res.push(['ℹ','Das FUP-Programm wurde nach dem Laden geändert – die LOGO! hat noch die alte Version.']);
  openModal('✔ Verdrahtung prüfen',res.length?`<ul class="chk">${res.map(([i,t])=>`<li><span>${i}</span><span>${t}</span></li>`).join('')}</ul><p class="note">✖ Fehler · ⚠ Warnung · ℹ Hinweis</p>`
    :'<p>✔ Keine Auffälligkeiten gefunden. Schalte die Spannung ein und teste!</p>',`<button class="pbtn" onclick="closeModal()">OK</button>`);
}
function wHelp(){
  openModal('So funktioniert „Verdrahtung &amp; Test“',`
  <p><b>1. Bauteile einfügen:</b> Links antippen – Taster, Schalter, NOT-HALT, Positionsschalter, Sensoren (digital/analog), Schütze und Meldeleuchten. Schaltzeichen nach DIN EN 60617.</p>
  <p><b>2. Verdrahten:</b> Von einem Anschluss ● zum nächsten ziehen – oder beide nacheinander antippen. Die Schienen oben (${lTermLbl('P1')}) und unten (${lTermLbl('P2')}) sind die Versorgung: Leitung einfach auf die Schiene ziehen. Leitung antippen → am Griff ■ verschieben oder löschen.</p>
  <p><b>Typische Verdrahtung:</b> ${lTermLbl('P1')}-Schiene → Taster 13 · Taster 14 → I1 · LOGO!-Klemme ${lTermLbl('P1')} an ${lTermLbl('P1')}, ${lTermLbl('P2')} an ${lTermLbl('P2')}, ⏚ FE an PE · ${lTermLbl('P1')}-Schiene → Q1 Klemme 1 · Q1 Klemme 2 → Schütz A1 · A2 → ${lTermLbl('P2')}-Schiene.</p>
  <p><b>3. Spannung EIN:</b> Jetzt ist Verdrahten gesperrt (Sicherheitsregel!). Leitungen mit Spannung (= 1) leuchten <b style="color:var(--hi)">rot</b>, der Rückleiter ist <b style="color:var(--lo)">blau</b>, analoge Signale <b style="color:var(--an)">orange</b>. Eingänge der LOGO! mit 1 und geschaltete Ausgangsrelais leuchten auf.</p>
  <p><b>4. Programm laden:</b> Netzwerkkabel einstecken (Kabel am PC oder die LAN-Buchse antippen), IP-Adresse der LOGO! eingeben, „In LOGO! laden“. Danach RUN. Das Display der LOGO! zeigt „No Program“, STOP oder RUN mit den Ein-/Ausgängen.</p>
  <p><b>PE und Funktionserde:</b> Unter der ${lTermLbl('P2')}-Schiene liegt die Schutzleiterschiene PE. Die LOGO! hat rechts am Gehäuse eine Klemme ⏚ <b>FE (Funktionserde)</b> – sie wird an PE angeschlossen. Sie ist <b>kein</b> Schutzleiteranschluss, sondern leitet Störungen (EMV) zur Erde ab. Antippen der Klemme zeigt die Erklärung.</p>
  <p><b>Leitungen verlegen:</b> Leitung antippen – dann waagerechte Abschnitte nach oben/unten und senkrechte Abschnitte nach links/rechts ziehen (an den Griffen ■ oder direkt am Abschnitt). „↺ Automatisch“ verlegt sie wieder neu.</p>
  <p><b>Hauptstromkreis:</b> Ein Bauteil aus der Gruppe „Hauptstromkreis“ einfügen – rechts neben der LOGO! erscheinen oben die Außenleiter L1, L2, L3 (Griff links an der Beschriftung zum Verschieben) und unten – wie im Steuerstromkreis – N und PE. Typisch: L1/L2/L3 → Leitungsschutzschalter -F2 → Motorschutzschalter -Q0 oder Schütz-Hauptkontakte -Q1 → Motorschutzrelais -F3 → Motor -M1 (U1, V1, W1, PE an PE). Teile mit <b>gleichem Kennzeichen</b> gehören zusammen (aufgelöste Darstellung): Spule -Q1 schaltet die Hauptkontakte -Q1 und die Hilfskontakte -Q1.</p>
  <p><b>Wendeschützschaltung:</b> Zweites Schütz -Q2 parallel zu -Q1, dabei zwei Außenleiter tauschen (z. B. L1 ↔ L3). Verriegelung mit den Hilfsöffnern 21–22: Öffner -Q2 vor die Spule -Q1 und Öffner -Q1 vor die Spule -Q2. Der Motor zeigt Rechts- oder Linkslauf.</p>
  <p><b>NOT-HALT:</b> Hauptöffner (3-polig) im Hauptstromkreis, Meldekontakt 13–14 (Schließer) an einen LOGO!-Eingang – beide mit demselben Kennzeichen (z. B. -S0). Im Test unten auf den roten Pilz drücken: Er rastet ein, erneutes Tippen entriegelt.</p>
  <p><b>Schutzgeräte im Test:</b> Leitungsschutz- und Motorschutzschalter antippen = EIN/AUS (bei Kurzschluss lösen sie aus). Motorschutzrelais antippen = Überlast simulieren, nochmal = Reset.</p>
  <p><b>5. Testen:</b> Taster gedrückt halten, Schalter antippen, Sensor antippen (Objekt erkannt), analoge Werte mit dem Schieberegler. Kurzschluss → Sicherung -F1 löst aus.</p>
  <p class="note">Ändert man das FUP-Programm, läuft in der LOGO! weiterhin die alte Version, bis neu geladen wird – wie in echt.</p>`,`<button class="pbtn" onclick="closeModal()">OK</button>`);
}
/* ---------- Leisten ---------- */
function buildWlib(){
  let h=`<div class="hwsel">LOGO!-Variante${segHtml('whwSeg',[['230','230 V'],['24','24 V']],S.hw)}</div>`;
  [['Befehlsgeber',['TNO','TNC','SNO','SNC','NH','PNO','PNC']],['Sensoren',['NNO','NNC','DS','AS']],['Aktoren',['K','P']],
   ['Hauptstromkreis',['LS3','MSS','KH','FRH','NHH','M3']],['Hilfskontakte',['KS','KO','FRO','FRS','NHS']]].forEach(([t,l])=>{
    h+=`<div class="lgrp">${t}</div>`;
    l.forEach(k=>{const K=WK[k];const dis=K.only&&S.hw!==K.only;
      h+=`<button class="litem witem${dis?' dis':''}" data-k="${k}" title="${K.n} ${K.sub}">${wLibIcon(k)}<span class="nm">${K.n}${K.sub?`<small>${K.sub}</small>`:''}</span></button>`;});});
  h+=`<div class="lgrp">Werkzeuge</div><button class="wtool" id="wtZuo" title="Für jede Klemme aus dem Programm das passende Bauteil einfügen">⚡ Bauteile aus Zuordnung</button>
    <button class="wtool" id="wtMain">${S.wd.main?'Hauptstromkreis ausblenden':'⚡ Hauptstromkreis einblenden'}</button>
    <button class="wtool" id="wtClr">🗑 Alle Leitungen löschen</button>`;
  $('#wlib').innerHTML=h;
  $('#wlib').querySelectorAll('.witem').forEach(el=>el.onclick=()=>addComp(el.dataset.k));
  document.querySelectorAll('#whwSeg button').forEach(bt=>bt.onclick=()=>setHw(bt.dataset.v));
  $('#wtZuo').onclick=wFromZuo;
  $('#wtMain').onclick=()=>{if(W.power)return;
    if(S.wd.main&&(S.wd.wires.some(w=>MR.includes(w.a.r)||MR.includes(w.b.r))||S.wd.comps.some(c=>WK[c.k].main))){toast('Erst die Bauteile und Leitungen des Hauptstromkreises löschen.');return;}
    change(()=>{S.wd.main=!S.wd.main;if(S.wd.main){const L=S.wd.logo;S.wd.hm={x:Math.max(S.wd.hm.x,L.x+LW+260),y:S.wd.rt};}});buildWlib();wFit();};
  $('#wtClr').onclick=()=>{if(!S.wd.wires.length)return;confirmBox('Alle Leitungen löschen?','Die Bauteile bleiben stehen, nur die Verdrahtung wird entfernt (rückgängig möglich).',()=>change(()=>{S.wd.wires=[];wsel=null;}));};
}
function wBuildBar(){
  const as=S.wd.comps.filter(c=>c.k==='AS');
  let h=`<div class="sgrp"><span class="gl">Netz</span><button class="pwrbtn" id="wPwr"></button></div>
    <div class="sgrp"><span class="gl">LOGO!</span><div class="wcard"><div class="row"><span class="wstate" id="wSt"></span><span id="wPrg"></span></div>
      <div class="row"><button class="sbtn" id="wRun"></button><button class="sbtn" id="wLpar">⚙ IP der LOGO!</button></div></div></div>
    <div class="sgrp"><span class="gl">PC</span><div class="wcard"><div class="row"><button class="sbtn" id="wCab"></button></div>
      <div class="row"><button class="pbtn" id="wLoad" style="padding:7px 12px">⬇ In LOGO! laden</button></div></div></div>`;
  if(as.length){h+=`<div class="sgrp"><span class="gl">Analog</span>`;
    as.forEach(c=>{const V=W.ana[c.id]??5;h+=`<div class="ageb"><div class="gtop"><b>${esc(c.name||'')}</b></div><span class="aval" id="wav${c.id}"></span>
      <input type="range" min="0" max="100" step="1" value="${Math.round(V*10)}" id="war${c.id}"><span class="gsub" id="wavv${c.id}"></span></div>`;});
    h+='</div>';}
  const nhs=[];S.wd.comps.forEach(c=>{if(WK[c.k].nh&&!nhs.some(x=>x[0]===nkey(c)))nhs.push([nkey(c),c.name||'']);});
  if(nhs.length){h+=`<div class="sgrp"><span class="gl">NOT-HALT</span>`;
    nhs.forEach(([k,n])=>{h+=`<button class="pilz" data-nh="${esc(k)}" title="NOT-HALT ${esc(n)} drücken / entriegeln"><span class="pz"></span><span class="pl">${esc(n)}</span><span class="ps"></span></button>`;});h+='</div>';}
  h+=`<div class="sbtns"><button class="sbtn" id="wChk">✔ Verdrahtung prüfen</button><button class="sbtn" id="wHelpB">? Hilfe</button></div><div class="wmsg" id="wmsg"></div>`;
  $('#wbar').innerHTML=h;
  $('#wPwr').onclick=()=>wPower(!W.power);
  $('#wRun').onclick=()=>wSetRun(!W.run);
  $('#wLpar').onclick=wLogoPar;
  $('#wCab').onclick=()=>wCable(!W.cable);
  $('#wLoad').onclick=wLoadDlg;
  $('#wChk').onclick=wCheck;$('#wHelpB').onclick=wHelp;
  $('#wbar').querySelectorAll('.pilz').forEach(b=>b.onclick=()=>{const k=b.dataset.nh;W.nh[k]=!W.nh[k];wUpdate();if(!W.power)wRefreshBar();});
  as.forEach(c=>{const r=$('#war'+c.id);r.addEventListener('input',()=>{W.ana[c.id]=+r.value/10;wUpdate();});r.addEventListener('touchstart',e=>e.stopPropagation(),{passive:true});});
  wRefreshBar();
}
function wRefreshBar(){
  if(tab!=='wire'||!$('#wPwr'))return;
  const p=$('#wPwr');p.textContent=W.power?'⏻ Spannung AUS':'⏻ Spannung EIN';p.classList.toggle('on',W.power);
  const st=$('#wSt');let s,c='';
  if(!W.power)s='aus';else if(!W.lp){s='keine Versorgung';c='err';}else if(W.loading)s='Laden …';else if(!S.lmem){s='No Program';c='stop';}else if(W.run){s='RUN';c='run';}else{s='STOP';c='stop';}
  st.textContent=s;st.className='wstate '+c;
  $('#wPrg').innerHTML=S.lmem?`Programm „${esc(trunc(S.lmem.name,18))}“ ${progChanged()?'<span class="warnt">⚠ veraltet</span>':'<span class="okt">✓</span>'}`:'<span class="warnt">kein Programm geladen</span>';
  const r=$('#wRun');r.textContent=W.run?'■ STOP':'▶ RUN';r.disabled=!S.lmem||!W.lp||W.loading;
  $('#wCab').textContent=W.cable?'🔌 Netzwerkkabel ziehen':'🔌 Netzwerkkabel einstecken';
  S.wd.comps.filter(c=>c.k==='AS').forEach(c=>{const el=$('#wav'+c.id);if(!el)return;const rg=c.rng||{unit:'V',min:0,max:10,dec:1},V=W.ana[c.id]??5;
    el.textContent=`${fmtN(rg.min+(rg.max-rg.min)*V/10,rg.dec)} ${rg.unit}`;$('#wavv'+c.id).textContent=`${fmtN(V,1)} V`;});
  $('#wbar').querySelectorAll('.pilz').forEach(b=>{const on=!!W.nh[b.dataset.nh];b.classList.toggle('on',on);b.querySelector('.ps').textContent=on?'verrastet – tippen = entriegeln':'drücken = NOT-HALT';});
  const m=$('#wmsg');let t='',err=false;
  const brT=S.wd.comps.find(c=>WK[c.k].brk&&W.brk[c.id]==='trip');
  if(W.trip){t='⚡ Sicherung -F1 ausgelöst (Kurzschluss). Fehler beheben, dann wieder einschalten.';err=true;}
  else if(brT){t=`⚡ ${brT.name||''} (${WK[brT.k].n}) hat ausgelöst. Fehler beheben, dann den Schalter antippen = wieder ein.`;err=true;}
  else if(Object.values(W.nh).some(v=>v)){t='🛑 NOT-HALT betätigt – zum Entriegeln den Pilz erneut antippen.';err=true;}
  else if(W.power&&!W.lp){t=`LOGO! ohne Versorgung – ${lTermLbl('P1')}/${lTermLbl('P2')} anschließen${S.hw==='24'?' (Polarität beachten!)':''}.`;err=true;}
  else if(W.osc){t='Schaltung schwingt – Rückführung prüfen.';err=true;}
  else if(W.power&&S.lmem&&progChanged())t='Hinweis: Im FUP wurde etwas geändert – erneut laden, um es zu testen.';
  else if(!W.power)t='Verdrahten: Spannung ist aus. Erst fertig verdrahten, dann einschalten.';
  m.textContent=t;m.className='wmsg'+(err?' err':'');
}
function setTab(t){
  if(t===tab)return;
  if(t==='wire'){
    if(mode==='sim')setMode('edit');
    sel=null;pending=null;pendCur=null;setHint();hidePop();updSel();
    tab='wire';document.body.classList.add('tabW');
    buildWlib();wBuildBar();wUpdSel();
    requestAnimationFrame(()=>{if(!wFitted){wFit();wFitted=true;}else wApplyView();wUpdate();});
  }else{
    if(W.power){wPower(false);toast('Beim Wechsel zum FUP-Programm wurde die Spannung ausgeschaltet.');}
    tab='fup';document.body.classList.remove('tabW');wpend=null;wHint();
    $('#stMode').textContent='Bearbeiten';applyView();render();updSel();
  }
  document.querySelectorAll('#tabs .tab').forEach(b=>b.classList.toggle('on',b.dataset.tab===tab));
  updLogoStatus();setTimeout(fitMenu,50);
}
document.querySelectorAll('#tabs .tab').forEach(b=>b.onclick=()=>setTab(b.dataset.tab));

/* ================= Start ================= */
