#mfoot:empty{display:none}
.pbtn{border:none;background:var(--bar2);color:#fff;border-radius:8px;padding:8px 16px;cursor:pointer;font-weight:600}
.gbtn2{border:1px solid var(--border);background:var(--btn);border-radius:8px;padding:8px 14px;cursor:pointer}
.frm{display:grid;grid-template-columns:auto 1fr;gap:8px 10px;align-items:center}
.frm label{font-weight:600;font-size:13px}
.frm input,.frm select{font:inherit;font-size:16px;padding:7px 8px;border-radius:7px;border:1px solid var(--border);background:var(--btn);color:var(--ink);width:100%}
.seg{display:flex;border:1px solid var(--border);border-radius:8px;overflow:hidden}
.seg button{flex:1;border:none;background:var(--btn);padding:7px 6px;cursor:pointer}
.seg button.on{background:var(--bar2);color:#fff}
.note{font-size:12px;color:var(--muted);margin-top:8px}
table.tt{border-collapse:collapse;margin:6px 0;font-size:13px}
table.tt th,table.tt td{border:1px solid var(--border);padding:3px 8px;text-align:center}
table.tt th{background:var(--panel)}
