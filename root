  CTR:{cat:'SF',grp:'C',name:'Vor-/Rückwärtszähler',ln:'Vor-/Rück&shy;wärts&shy;zähler',en:'Up/down counter',n:3,pins:['R','Cnt','Dir'],w:60,sym:'+/−',par:1},
