    else if(b.t==='TOF')h+=`<path class="icon" d="M${cx-8} ${cy+7}v-14h13v14h9"/><text class="pinlbl" x="${cx+7}" y="${cy-3}">T</text>`+g.ins.map((p,i)=>`<text class="pinlbl" x="${b.x+4}" y="${p.y+3}">${T.pins[i]}</text>`).join('')+`<text class="pinlbl" x="${b.x+g.w-10}" y="${g.out.y+14}">Q</text>`;
