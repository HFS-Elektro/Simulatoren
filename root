/* Nächster Leitungsabschnitt zu Punkt p: 'h' waagerecht, 'a'/'b' senkrecht an Seite A/B */
function wSegAt(r,p){
  // Gerade Leitung (kein waagerechter Versatz): immer die ganze Leitung seitlich verschieben
  if(r.Y===null||r.ax===r.bx)return 'ab';
  const dv=(x,y1,y2)=>{const lo=Math.min(y1,y2),hi=Math.max(y1,y2);return Math.hypot(p.x-x,p.y<lo?lo-p.y:p.y>hi?p.y-hi:0);};
  const dh=(y,x1,x2)=>{const lo=Math.min(x1,x2),hi=Math.max(x1,x2);return Math.hypot(p.y-y,p.x<lo?lo-p.x:p.x>hi?p.x-hi:0);};
  const c=[['h',r.ax!==r.bx?dh(r.Y,r.ax,r.bx):1e9],['a',Math.abs(r.Y-r.ya)>=8?dv(r.ax,r.ya,r.Y):1e9],['b',Math.abs(r.Y-r.yb)>=8?dv(r.bx,r.Y,r.yb):1e9]];
  c.sort((x,y)=>x[1]-y[1]);return c[0][1]<30/wview.s?c[0][0]:null;}

