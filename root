  TONR:{cat:'SF',grp:'T',name:'Speichernde Einschaltverzögerung',ln:'Speichernde Einschalt&shy;verzögerung',en:'Retentive on-delay',n:2,pins:['Trg','R'],w:60,sym:'⊓R',par:1},
