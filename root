  if(pA)A={x:A.x+A.hx,y:A.y,dir:1,off:0};if(pB)B={x:B.x+B.hx,y:B.y,dir:1,off:0};
  const A2={x:A.x,y:A.y+A.dir*A.off},B2={x:B.x,y:B.y+B.dir*B.off};let Y;
  const facing=(A.dir>0&&B.dir<0&&A.y<B.y)||(A.dir<0&&B.dir>0&&A.y>B.y);
  const ax=A.x+(w.a.r?0:(w.dxa||0)),bx=B.x+(w.b.r?0:(w.dxb||0));
  if(w.my!==undefined)Y=w.my;
  else if(ax===bx&&A.x===B.x&&ax===A.x&&facing)Y=null;
  else if(A.x===B.x&&facing)Y=snap((A2.y+B2.y)/2);
  else if(A.dir===B.dir)Y=A.dir>0?Math.max(A2.y,B2.y):Math.min(A2.y,B2.y);
  else{const ok=(A.dir>0&&A2.y<=B2.y)||(A.dir<0&&A2.y>=B2.y);Y=ok?snap((A2.y+B2.y)/2):A2.y;}
  let pts=Y===null?[A,B]:[A,A2,{x:ax,y:A2.y},{x:ax,y:Y},{x:bx,y:Y},{x:bx,y:B2.y},B2,B];
  if(pA)pts.unshift(pA);if(pB)pts.push(pB);
  pts=pts.filter((p,i)=>i===0||p.x!==pts[i-1].x||p.y!==pts[i-1].y).map(p=>({x:p.x,y:p.y}));
