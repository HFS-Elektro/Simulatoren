function startAnim(){if(animOn)return;animOn=true;lastT=performance.now();requestAnimationFrame(tick);}
function tick(t){
  if(mode!=='sim'||!$('#plant').classList.contains('show')){animOn=false;return;}
  const dt=Math.min(0.1,(t-lastT)/1000);lastT=t;
  const q=qVals(sim);let dir=0;
  if(!hwStop()&&!(q.Q1&&q.Q2)){if(q.Q1)dir=1;else if(q.Q2)dir=-1;}
  angle+=dir*90*dt; // 4 s pro Runde
  $('#krot').setAttribute('transform',`rotate(${angle} 110 92)`);
  $('#dirTxt').textContent=dir>0?'↻ Rechtslauf':dir<0?'↺ Linkslauf':'steht';
  const na=((angle%360)+360)%360;const cam=na<7||na>353;
