  for(let i=0;i<c.length;i++){const l=pts[pts.length-1];pts.push(i%2===0?{x:c[i],y:l.y}:{x:l.x,y:c[i]});}
  const l=pts[pts.length-1];pts.push({x:l.x,y:b.y});pts.push({x:b.x,y:b.y});
