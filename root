/* ---------- Bausteinerklärung ---------- */
function ttGate(f,n=2){
  let r='<table class="tt"><tr>';for(let i=0;i<n;i++)r+=`<th>E${i+1}</th>`;r+='<th class="osep">A</th></tr>';
  for(let m=0;m<(1<<n);m++){const bits=[];for(let i=n-1;i>=0;i--)bits.push((m>>i)&1);const o=f(bits);
    r+='<tr>'+bits.map(x=>`<td class="v${x}">${x}</td>`).join('')+`<td class="o osep v${o}">${o}</td></tr>`;}
  return r+'</table>';
}
