/* Statuszeile */
#status{flex:0 0 auto;display:flex;gap:14px;align-items:center;font-size:12px;color:var(--muted);background:var(--panel);border-top:1px solid var(--border);
  padding:3px 10px;padding-left:max(10px,env(safe-area-inset-left));white-space:nowrap;overflow:hidden}
#status .mode{font-weight:700;color:var(--ink)}
/* SVG-Elemente */
.gridrect{fill:url(#gridp)}
#gridp circle{fill:var(--grid)}
.body{fill:var(--blockfill);stroke:var(--blockstroke);stroke-width:1.6}
.blk.sel .body{stroke:var(--sel);stroke-width:2.6;fill:var(--selfill)}
.body.on{fill:var(--hifill)}
.stub{stroke:var(--blockstroke);stroke-width:1.6}
.negc{fill:var(--blockfill);stroke:var(--blockstroke);stroke-width:1.6}
.sym{font-weight:700;font-size:16px;fill:var(--ink);text-anchor:middle;dominant-baseline:central;pointer-events:none}
.addr{font-weight:700;font-size:13px;fill:var(--ink);text-anchor:middle;dominant-baseline:central;pointer-events:none}
.bnum{font-size:9px;fill:var(--muted);pointer-events:none}
.cmt{font-size:10px;fill:var(--sel);pointer-events:none;font-weight:600}
.tag{font-size:8px;fill:var(--muted);pointer-events:none}
.pinlbl{font-size:9px;fill:var(--ink);pointer-events:none;font-weight:600}
.pinhit{fill:transparent;pointer-events:all;cursor:crosshair}
.pindot{fill:var(--blockstroke);pointer-events:none}
.pinhit.cand{fill:var(--sel);fill-opacity:.18;stroke:var(--sel);stroke-width:1.2;animation:pulse 1s infinite}
.pinhit.src{fill:var(--sel);fill-opacity:.35;stroke:var(--sel);stroke-width:1.5}
@keyframes pulse{50%{fill-opacity:.38}}
.w{fill:none;stroke:var(--wire);stroke-width:1.6;pointer-events:none}
.w.sel{stroke:var(--sel);stroke-width:3}
.w.hi{stroke:var(--hi);stroke-width:2.4}
.w.lo{stroke:var(--lo);stroke-width:2.4}
.whit{fill:none;stroke:transparent;stroke-width:22;pointer-events:stroke;cursor:pointer}
.wtmp{fill:none;stroke:var(--sel);stroke-width:2;stroke-dasharray:5 4;pointer-events:none}
.whit.fix{cursor:pointer}.whit.mv{cursor:move}
.w.an{stroke:var(--an);stroke-width:2.2}.flag.an{fill:var(--an)}.jdot.an{fill:var(--an)}
.ptag{font-size:9px;fill:var(--muted);pointer-events:none}
.pval{font-size:10px;font-weight:700;fill:var(--an);pointer-events:none}
.pval.d{fill:var(--sel)}
.icon{fill:none;stroke:var(--ink);stroke-width:1.6;pointer-events:none}
.selbox{fill:var(--sel);fill-opacity:.08;stroke:var(--sel);stroke-width:1.2;stroke-dasharray:4 3;pointer-events:none}
.blk.msel .body{stroke:var(--sel);stroke-width:2.6;fill:var(--selfill)}
.litem.dis{opacity:.35}
.hwsel{margin:4px 2px 2px;font-size:11px;font-weight:700;color:var(--muted)}
.hwsel .seg button{padding:5px 2px;font-size:11px}
.fab.on{background:var(--sel);color:#fff;border-color:var(--sel)}
.fab.hide{display:none}
.ageb{display:flex;flex-direction:column;align-items:center;gap:3px;min-width:132px;padding:4px 6px;border:1px solid var(--border);border-radius:9px;background:var(--card)}
.ageb input[type=range]{width:120px;touch-action:none;accent-color:var(--an)}
.ageb .aval{font-size:15px;font-weight:700;color:var(--an);font-variant-numeric:tabular-nums}
#trend{position:absolute;left:0;right:0;bottom:0;height:42%;min-height:160px;background:var(--card);border-top:2px solid var(--sel);display:none;flex-direction:column;z-index:5}
#trend.show{display:flex}
#trend .th{display:flex;align-items:center;gap:6px;padding:4px 8px;font-weight:700;font-size:13px}
#trend .th .sp{flex:1}
#trend .th button{border:1px solid var(--border);background:var(--btn);border-radius:7px;padding:4px 9px;cursor:pointer;min-height:32px}
#trendBox{flex:1;position:relative;overflow-y:auto;touch-action:pan-y}
#trendCv{display:block;width:100%}
table.zt{border-collapse:collapse;width:100%;font-size:13px}
table.zt th,table.zt td{border:1px solid var(--border);padding:4px 6px;text-align:left}
table.zt th{background:var(--panel)}
table.zt td.miss{color:var(--muted);font-style:italic}
.jdot{fill:var(--wire);pointer-events:none}.jdot.hi{fill:var(--hi)}.jdot.lo{fill:var(--lo)}.jdot.sel{fill:var(--sel)}
.hdl{fill:var(--card);stroke:var(--sel);stroke-width:2;cursor:move}
.plist{list-style:none;padding:0;margin:6px 0}
.plist li{display:flex;align-items:center;gap:6px;padding:7px 4px;border-bottom:1px solid var(--border)}
.plist li.cur{background:var(--selfill);border-radius:8px}
.plist .pn{flex:1;min-width:0}.plist .pn b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.plist .pn small{color:var(--muted)}
.ibtn{border:1px solid var(--border);background:var(--btn);border-radius:8px;padding:6px 9px;cursor:pointer;min-height:36px}
.pact{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
#projName{max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer}
.flag{font-size:10px;font-weight:700;pointer-events:none}
.flag.hi{fill:var(--hi)}.flag.lo{fill:var(--lo)}
/* Simulationsleiste */
#simbar{flex:0 0 auto;display:none;background:var(--panel);border-top:2px solid var(--hi);padding:6px 8px;gap:10px;align-items:stretch;overflow-x:auto;
  padding-left:max(8px,env(safe-area-inset-left));padding-bottom:max(6px,env(safe-area-inset-bottom))}
body.sim #simbar{display:flex}
.sgrp{display:flex;gap:6px;align-items:stretch}
