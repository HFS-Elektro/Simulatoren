function computeBus(){
  busX=new Map();const grp=new Map();
  S.wires.forEach(w=>{if(w.c)return;const e=wireEnds(w);if(!e||e.b.x<e.a.x+20)return;
    const m=snap((e.a.x+e.b.x)/2);if(!grp.has(w.f))grp.set(w.f,[]);grp.get(w.f).push({m,bx:e.b.x,ax:e.a.x,ay:e.a.y,by:e.b.y});});
  // Senkrechte Abschnitte verschiedener Quellen nicht übereinanderlegen (sonst sähe eine Kreuzung wie eine Verbindung aus)
  const occ=[];
  [...grp.entries()].sort((x,y)=>x[0]-y[0]).forEach(([f,l])=>{
    let m=Math.min(...l.map(o=>o.m));const ax=l[0].ax,minB=Math.min(...l.map(o=>o.bx));if(m<=ax)m=snap(ax+10);
    const ys=l.map(o=>o.by).concat(l[0].ay);const y0=Math.min(...ys),y1=Math.max(...ys);
    const free=x=>!occ.some(o=>o.x===x&&o.y0<=y1+4&&o.y1>=y0-4);
    let best=m;for(let k=0;k<12;k++){const c=m+(k%2?1:-1)*Math.ceil(k/2)*GRID;if(c>ax&&c<minB&&free(c)){best=c;break;}}
