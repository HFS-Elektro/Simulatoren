  for(const i of [1,2]){const j=grJoint(w,[i]).filter(q=>q[0]!==w);if(!j.length)continue;const off=Math.max(...j.map(q=>q[0].t))/2;if(i===1)add(off+10,off+30);else add(L-off-30,L-off-10)}
  for(const v of g.w)if(v!==w)for(const k of [1,2]){const px=v['x'+k]-w.x1,py=v['y'+k]-w.y1,u=px*ux+py*uy,d=Math.abs(px*uy-py*ux);if(d<w.t/2+1&&u>5&&u<L-5){const o=v.t/2;add(u-o-30,u-o-10);add(u+o+10,u+o+30)}}
  for(const o of g.o)if(o.w===w.id){const b=Math.min(o.b,L),u=Math.max(b/2,Math.min(L-b/2,o.u));add(u-b/2-30,u-b/2-10);add(u+b/2+10,u+b/2+30)}
  return Z}
// Schalter und Steckdosen rasten an der nächsten Wand ein (Umschalt-Taste hält sie frei); Steckdosen drehen sich so, dass der Anschluss an der Wand sitzt und das Symbol in den Raum zeigt
const GSTK={std:2,std2:2,aus:9,ser:9,wec:9,kre:9,tas:11};
function grStick(e){if(view!=='inst'||e.type!=='isym'||!(e.props.kind in GSTK))return;const n=grNear({x:e.x,y:e.y},45);if(!n)return;
  const w=n.w,L=grLen(w)||1,ux=(w.x2-w.x1)/L,uy=(w.y2-w.y1)/L,px=w.x1+ux*n.u,py=w.y1+uy*n.u;let nx=-uy,ny=ux;if((e.x-px)*nx+(e.y-py)*ny<0){nx=-nx;ny=-ny}
  const o=w.t/2+GSTK[e.props.kind];e.x=Math.round(px+nx*o);e.y=Math.round(py+ny*o);
  if(e.props.kind==='std'||e.props.kind==='std2'){const dx=nx,dy=ny;e.r=Math.abs(dx)>=Math.abs(dy)?(dx<0?1:3):(dy>0?0:2);e.m=false}}
function grDown(h){const g=GR(),p=down.p;
  if(place==='gr:wand'||place==='gr:raum'){down.gnew=grSnap(p);return}
  if(place||erase||g.lock||down.drag||down.link)return;
  if(h.k==='gw'){const w=grW(h.id);if(w)down.gw={j:grJoint(w,[1,2])}}
  else if(h.k==='ge'){const[id,i]=h.id.split(':'),w=grW(id);if(w)down.ge={w,i:+i,j:grJoint(w,[+i])}}
  else if(h.k==='go'){const o=grO(h.id);if(o)down.go=o}
  else if(h.k==='gn'){const r=grN(h.id);if(r)down.gn={r,x:r.x,y:r.y}}}
function grMove(e){const d=down;if(!d||!(d.gnew||d.gw||d.ge||d.go||d.gn))return false;const p=svgPt(e);
  if(d.gnew){const b=place==='gr:raum'?grSnap(p):grEnd(d.gnew,p);grTmp=place==='gr:raum'?grRect(d.gnew,b,grT):[{x1:d.gnew.x,y1:d.gnew.y,x2:b.x,y2:b.y,t:grT}];drawPlan();return true}
  if(!d.gsnap){d.gsnap=1;snap()}
  if(d.gw){const dx=Math.round((p.x-d.p.x)/10)*10,dy=Math.round((p.y-d.p.y)/10)*10;for(const[v,i,x,y]of d.gw.j){v['x'+i]=x+dx;v['y'+i]=y+dy}}
  else if(d.ge){const w=d.ge.w,o=3-d.ge.i,q=grEnd({x:w['x'+o],y:w['y'+o]},p,d.ge.j.map(j=>j[0]));for(const[v,i]of d.ge.j){v['x'+i]=q.x;v['y'+i]=q.y}}
  else if(d.go){const o=d.go,w=grW(o.w);if(w){const L=grLen(w)||1;o.u=Math.round(Math.max(o.b/2,Math.min(L-o.b/2,(p.x-w.x1)*(w.x2-w.x1)/L+(p.y-w.y1)*(w.y2-w.y1)/L))/5)*5}}
  else if(d.gn){d.gn.r.x=Math.round((d.gn.x+p.x-d.p.x)/10)*10;d.gn.r.y=Math.round((d.gn.y+p.y-d.p.y)/10)*10}
  drawPlan();return true}
function grUp(d){if(d.gnew){const t=(grTmp||[]).filter(w=>grLen(w)>=10);grTmp=null;if(!d.moved){say(GRH[place]);render();return true}if(!t.length){render();return true}
    const room=place==='gr:raum';mut(()=>{const g=GR();for(const w of t)g.w.push({id:nid('w'),x1:w.x1,y1:w.y1,x2:w.x2,y2:w.y2,t:w.t});
      if(room&&t.length===4){const W=Math.abs(t[0].x2-t[0].x1),H=Math.abs(t[1].y2-t[1].y1),A=Math.max(0,(W-grT)*(H-grT))/1e4,r={id:nid('n'),x:Math.round((t[0].x1+t[0].x2)/20)*10,y:Math.round((t[1].y1+t[1].y2)/20)*10,t:'Raum',a:A>0?f2(A,1)+' m²':''};g.r.push(r);sel={k:'gn',id:r.id};place=null}});return true}
  if((d.gw||d.ge||d.go||d.gn)&&d.moved){render();return true}return false}
function grTap(d,sp){const g=GR(),G=GRK.includes(d.k);
  if(place&&place.startsWith('gr:')){
    if(place==='gr:tuer'||place==='gr:fenster'){const n=grNear(d.p);if(!n){say('Tür und Fenster: direkt auf eine Wand tippen.');render();return true}
      const w=n.w,L=grLen(w),dr=place==='gr:tuer',b=Math.min(L,dr?(w.t>=20?101:88.5):120);
      mut(()=>{const o={id:nid('o'),w:w.id,k:dr?'t':'f',b,u:Math.round(Math.max(b/2,Math.min(L-b/2,n.u))/5)*5,f:0};g.o.push(o);sel={k:'go',id:o.id}});return true}
    if(place==='gr:name'){mut(()=>{const r={id:nid('n'),x:sp.x,y:sp.y,t:'Raum',a:''};g.r.push(r);sel={k:'gn',id:r.id};place=null});return true}
    say(GRH[place]);render();return true}
  if(place){if(G)d.k='bg';return false}
  if(!G)return false;
  if(erase){if(d.k!=='ge'){sel={k:d.k,id:d.id};delSel()}else render();return true}
  sel={k:d.k==='ge'?'gw':d.k,id:d.k==='ge'?d.id.split(':')[0]:d.id};wireFrom=null;render();return true}
function grDel(){const g=GR(),k=sel.k,id=sel.id;mut(()=>{if(k==='gw'){g.w=g.w.filter(w=>w.id!==id);g.o=g.o.filter(o=>o.w!==id)}else if(k==='go')g.o=g.o.filter(o=>o.id!==id);else g.r=g.r.filter(r=>r.id!==id);sel=null})}
function grSetLen(v){v=parseFloat(String(v).replace(',','.'))*100;const w=grW(sel.id);if(!w||!(v>=10))return render();
  mut(()=>{const L=grLen(w)||1,nx=Math.round(w.x1+(w.x2-w.x1)*v/L),ny=Math.round(w.y1+(w.y2-w.y1)*v/L);for(const[q,i]of grJoint(w,[2])){q['x'+i]=nx;q['y'+i]=ny}})}
function grBar(){if(sel.k==='gw'){const w=grW(sel.id);if(!w)return'';
    return`<b>Wand</b><label>Länge <input type="number" step="0.01" min="0.1" value="${(grLen(w)/100).toFixed(2)}" style="width:5.5em" onchange="grSetLen(this.value)"> m</label><span class="lbl">Dicke (cm)</span>${[36.5,30,24,17.5,11.5].map(t=>`<button class="${w.t===t?'on':''}" onclick="mut(()=>grW(sel.id).t=${t})">${fCm(t)}</button>`).join('')}<span class="hint">Wand ziehen = verschieben, blaue Punkte ziehen = Ende verschieben</span><button class="warn" onclick="delSel()">Löschen</button>`}
  if(sel.k==='go'){const o=grO(sel.id);if(!o)return'';const bs=[...new Set((o.k==='t'?[76,88.5,101,126,151]:[60,80,100,120,150,200,250]).concat(o.b))].sort((a,b)=>a-b);
    return`<b>${o.k==='t'?'Tür':'Fenster'}</b><label>Breite <select onchange="mut(()=>grO(sel.id).b=+this.value)">${bs.map(b=>`<option value="${b}"${b===o.b?' selected':''}>${fCm(b)} cm</option>`).join('')}</select></label>`+
      (o.k==='t'?'<button onclick="mut(()=>grO(sel.id).f^=1)">Anschlag ⇋</button><button onclick="mut(()=>grO(sel.id).f^=2)">Aufschlag ⇅</button>':'')+'<span class="hint">ziehen = entlang der Wand verschieben</span><button class="warn" onclick="delSel()">Löschen</button>'}
  const r=grN(sel.id);if(!r)return'';
  return`<b>Raum</b><label>Name <input value="${esc(r.t)}" size="14" onchange="mut(()=>grN(sel.id).t=this.value.trim()||'Raum')"></label><label>Zusatz <input value="${esc(r.a||'')}" size="9" placeholder="z. B. 12 m²" onchange="mut(()=>grN(sel.id).a=this.value.trim())"></label><span class="hint">ziehen = verschieben</span><button class="warn" onclick="delSel()">Löschen</button>`}
function grPal(){const g=GR(),b=(t,ic,n,ti)=>`<button class="pi${place===t?' on':''}" onclick="setPlace('${t}')" title="${ti}"><b>${ic}</b><span>${n}</span></button>`;
  return b('gr:wand','▬','Wand',GRH['gr:wand'])+b('gr:raum','▭','Raum',GRH['gr:raum'])+b('gr:tuer','◜','Tür',GRH['gr:tuer'])+b('gr:fenster','▥','Fenster',GRH['gr:fenster'])+b('gr:name','Aa','Raumname',GRH['gr:name'])+
    `<span class="sep"></span><span class="lbl">Neue Wände</span><div class="seg">${[[24,'Außen 24 cm'],[11.5,'Innen 11,5 cm']].map(([t,n])=>`<button class="${grT===t?'on':''}" onclick="grT=${t};render()">${n}</button>`).join('')}</div>`+
    `<span class="sep"></span><button class="pi${g.dim?' on':''}" onclick="mut(()=>GR().dim=!GR().dim)" title="Wandlängen anzeigen"><b>↔</b><span>Maße ${g.dim?'an':'aus'}</span></button>`+
    `<button class="pi${g.zon?' on':''}" onclick="mut(()=>GR().zon=!GR().zon);if(GR().zon)say(GRZ)" title="${GRZ}"><b>▥</b><span>Zonen ${g.zon?'an':'aus'}</span></button>`+
    `<button class="pi${g.lock?' on':''}" onclick="mut(()=>{GR().lock=!GR().lock;if(sel&&GRK.includes(sel.k))sel=null})" title="Fixiert den Grundriss, damit beim Einzeichnen der Installation nichts verrutscht"><b>${g.lock?'🔒':'🔓'}</b><span>Grundriss ${g.lock?'fixiert':'frei'}</span></button>`+
    `<button class="pi" onclick="grLib()" title="Grundrisse speichern, laden, exportieren und importieren"><b>💾</b><span>Grundrisse …</span></button>`}
function grLBtn(){const s=P.sheets.inst;return`<span class="sep"></span><button class="pi${s.noL?'':' on'}" onclick="mut(()=>P.sheets.inst.noL=!P.sheets.inst.noL)" title="Leitungsführung im Installationsplan ein- oder ausblenden"><b>${s.noL?'○':'●'}</b><span>Leitungsführung ${s.noL?'aus':'an'}</span></button>`}
// Grundriss-Bibliothek im Browser (hfs_grundrisse) und als Datei (app: hfs-grundriss)
function grStore(){try{return JSON.parse(localStorage.getItem(GRKEY)||'{}')}catch(e){return{}}}
const grData=()=>{const g=GR();return JSON.parse(JSON.stringify({w:g.w,o:g.o,r:g.r,dim:!!g.dim}))},grKey=k=>encodeURIComponent(k).replace(/'/g,'%27');
function grLib(){const st=grStore(),ks=Object.keys(st).sort((a,b)=>st[b].ts-st[a].ts);
  modal('Grundrisse','<p>Der Grundriss liegt unter dem Installationsplan und wird mit dem Projekt gespeichert. Hier kannst du ihn zusätzlich unter einem Namen ablegen, als Datei weitergeben und in andere Projekte laden. Die eingezeichneten Symbole und Leitungen bleiben dabei erhalten.</p>'+
    `<div class="row"><input id="grNm" placeholder="Name des Grundrisses" value="${esc(P.name||'')}" style="flex:1;min-width:0"><button class="pri" onclick="grSave()">Speichern</button></div>`+
    '<div class="row" style="flex-wrap:wrap;gap:6px;justify-content:flex-start"><button onclick="grExport()">Als Datei exportieren</button><button onclick="grImport()">Datei importieren</button><button onclick="grTpl()">Beispielwohnung</button><button class="warn" onclick="grClear()">Grundriss leeren</button></div>'+
    '<h4>Gespeicherte Grundrisse</h4>'+(ks.length?ks.map(k=>`<div class="row"><span>${esc(k)} <small>(${st[k].n} Wände)</small></span><span style="display:flex;gap:4px"><button onclick="grLoad('${grKey(k)}')">Laden</button><button onclick="grExport('${grKey(k)}')">Datei</button><button class="warn" onclick="grDelS('${grKey(k)}')">Löschen</button></span></div>`).join(''):'<p>Noch keine gespeichert.</p>'))}
function grSave(){const n=($('#grNm').value||'').trim(),g=GR();if(!n)return say('Bitte einen Namen eingeben.');if(!g.w.length)return say('Der Grundriss ist noch leer.');
  const st=grStore();st[n]={ts:Date.now(),n:g.w.length,data:grData()};try{localStorage.setItem(GRKEY,JSON.stringify(st))}catch(e){return say('Der Browserspeicher ist voll – bitte Grundrisse exportieren und alte löschen.')}say('Grundriss „'+n+'“ gespeichert.');grLib()}
function grDelS(k){k=decodeURIComponent(k);const st=grStore();delete st[k];try{localStorage.setItem(GRKEY,JSON.stringify(st))}catch(e){}say('Grundriss „'+k+'“ gelöscht.');grLib()}
// übernimmt einen Grundriss mit neuen IDs (keine Überschneidung mit den IDs des Projekts)
function grPut(d){if(!d||!Array.isArray(d.w))return say('Die Datei enthält keinen Grundriss.'),false;
  mut(()=>{const m={},s=P.sheets.inst,num=v=>+v||0;s.gr={w:d.w.map(w=>{const id=nid('w');m[w.id]=id;return{id,x1:num(w.x1),y1:num(w.y1),x2:num(w.x2),y2:num(w.y2),t:num(w.t)||24}}),
    o:(d.o||[]).filter(o=>m[o.w]).map(o=>({id:nid('o'),w:m[o.w],k:o.k==='f'?'f':'t',b:num(o.b)||90,u:num(o.u),f:num(o.f)&3})),r:(d.r||[]).map(r=>({id:nid('n'),x:num(r.x),y:num(r.y),t:String(r.t||'Raum'),a:String(r.a||'')})),dim:!!d.dim,lock:false};sel=null;place=null});grFit();return true}
function grFit(){const g=GR();if(!g.w.length||view!=='inst')return;let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;for(const w of g.w){x0=Math.min(x0,w.x1,w.x2);y0=Math.min(y0,w.y1,w.y2);x1=Math.max(x1,w.x1,w.x2);y1=Math.max(y1,w.y1,w.y2)}
  const r=cv().getBoundingClientRect(),asp=(r.width||1)/(r.height||1),W=Math.max(x1-x0+160,(y1-y0+160)*asp);VB.inst={x:(x0+x1)/2-W/2,y:(y0+y1)/2-W/asp/2,w:W};applyVB()}
function grLoad(k){k=decodeURIComponent(k);const st=grStore();if(!st[k])return;closeModal();if(grPut(st[k].data))say('Grundriss „'+k+'“ geladen.')}
function grExport(k){let d,n;if(k){k=decodeURIComponent(k);const st=grStore();if(!st[k])return;d=st[k].data;n=k}else{if(!GR().w.length)return say('Der Grundriss ist noch leer.');d=grData();n=P.name||'Grundriss'}
  dl(JSON.stringify({app:'hfs-grundriss',name:n,gr:d}),'Grundriss_'+n);say('Grundriss „'+n+'“ als Datei exportiert.')}
function grImport(){const i=document.createElement('input');i.type='file';i.accept='.json,application/json';
  i.onchange=()=>{const f=i.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{let o=JSON.parse(r.result);if(o.app==='hfs-sim'){const u=xUnpack(o);o=u?JSON.parse(u.json):{}}const d=o.app==='hfs-grundriss'?o.gr:o.app==='schaltwerk'&&o.sheets&&o.sheets.inst?o.sheets.inst.gr:null;
      if(!d||!d.w||!d.w.length)return say('Die Datei enthält keinen Grundriss.');closeModal();if(grPut(d))say('Grundriss „'+(o.name||f.name)+'“ importiert.')}catch(e){say('Die Datei konnte nicht gelesen werden.')}};r.readAsText(f)};i.click()}
function grClear(){closeModal();mut(()=>{P.sheets.inst.gr={w:[],o:[],r:[]};sel=null});say('Grundriss geleert (Rückgängig ist möglich).')}
function grTpl(){closeModal();const W=(id,x1,y1,x2,y2,t)=>({id,x1,y1,x2,y2,t}),O=(w,k,u,b,f)=>({w,k,u,b,f}),R=(x,y,t,a)=>({x,y,t,a});
  grPut({w:[W(1,100,100,1000,100,24),W(2,1000,100,1000,800,24),W(3,100,800,1000,800,24),W(4,100,100,100,800,24),W(5,600,100,600,500,11.5),W(6,100,500,1000,500,11.5),W(7,450,500,450,800,11.5),W(8,750,500,750,800,11.5)],
    o:[O(3,'t',500,101,2),O(6,'t',425,88.5,2),O(6,'t',575,88.5,3),O(7,'t',150,88.5,0),O(8,'t',150,76,2),O(1,'f',250,200,0),O(1,'f',700,150,0),O(4,'f',550,120,0),O(2,'f',550,80,0)],
    r:[R(350,290,'Wohnen','18,4 m²'),R(800,290,'Schlafen','14,6 m²'),R(275,640,'Küche','9,4 m²'),R(600,610,'Flur','8,1 m²'),R(870,640,'Bad','6,6 m²')],dim:false});say('Beispielwohnung geladen. Jetzt die Installation mit den Symbolen einzeichnen.')}

// Maßstab für den Installationsplan auf der Abgabe (A4 quer, 2339 px = 297 mm → 78,75 px je cm Papier): größter Normmaßstab, der passt
function grMs(im){if(!GR().w.length||!im._k)return 0;for(const M of [50,100,200]){const s=78.75/M/im._k;if(im.width*s<=2219&&im.height*s<=1289)return M}return 0}

// ---------- Dialoge ----------
function modal(title,html){$('#mtitle').textContent=title;$('#mbody').innerHTML=html;$('#modal').style.display='flex'}
function closeModal(){$('#modal').style.display='none'}
function chooseInsert(b,slot){modal('Einsatz für '+(b.kind==='sd2'?'Platz '+(slot+1)+' im Doppelgehäuse':'die Dose'),INSERTS.map(t=>`<button class="big" onclick="setInsert('${b.id}','${t}',${slot})">${icon(t)} ${T[t].name}</button>`).join('')+(slotDev(b,slot)?`<button class="big warn" onclick="setInsert('${b.id}',null,${slot})">Einsatz ausbauen</button>`:''))}
function rmDev(b,id){b.devs=b.devs.filter(d=>d.id!==id);rmLinksOf(k=>k.startsWith(id+'.'))}
function setInsert(bid,t,slot){closeModal();mut(()=>{const b=boxById(bid),o=slotDev(b,slot);if(o)rmDev(b,o.id);if(t){const e=mkEl(t,'board');e.slot=slot;b.devs.push(e)}})}
function setRows(bid,n,m){const b=boxById(bid),r=rowsOf(b)+n;if(r<1||r>6)return say(r<1?'Mindestens eine Hutschiene.':'Höchstens 6 Hutschienen.');mut(()=>{if(n<0)for(const d of b.devs)if((d.row||0)>=r)d.row=r-1;b.rows=r});if(m)chooseReg(b)}
function setDevRow(bid,id,r){const b=boxById(bid);mut(()=>{const d=b.devs.find(d=>d.id===id);if(d)d.row=r});chooseReg(b)}
function devMv(dx,dy){const b=boxById(detail);if(!b||!dSel||dSel.k!=='dev')return;mut(()=>{const i=b.devs.findIndex(d=>d.id===dSel.id);if(i<0)return;const d=b.devs[i];
  if(dy){d.row=Math.max(0,Math.min(rowsOf(b)-1,devRow(b,d)+dy));return}const r=devRow(b,d);let j=i+dx;while(j>=0&&j<b.devs.length&&(devRow(b,b.devs[j])!==r||b.devs[j].type==='sas'))j+=dx;if(j<0||j>=b.devs.length)return;b.devs[i]=b.devs[j];b.devs[j]=d})}
