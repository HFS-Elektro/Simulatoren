.geb,.qout{display:flex;flex-direction:column;align-items:center;gap:2px;min-width:68px;padding:4px 3px;border:1px solid var(--border);border-radius:9px;background:var(--card)}
.gtop{display:flex;align-items:center;gap:4px;font-size:12px}
.led{width:9px;height:9px;border-radius:50%;background:var(--lo);display:inline-block}
.led.on{background:var(--hi);box-shadow:0 0 6px var(--hi)}
.gname{font-size:11px;color:var(--sel);font-weight:700;max-width:72px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.gbtn{width:54px;height:50px;border-radius:9px;border:1.5px solid var(--border);background:var(--btn);cursor:pointer;touch-action:none;padding:0;display:flex;align-items:center;justify-content:center}
.gbtn.pressed{background:var(--btnh);border-color:var(--sel);box-shadow:inset 0 2px 6px rgba(0,0,0,.25)}
.gbtn svg{width:40px;height:46px}
.gsub{font-size:10px;color:var(--muted);text-align:center;line-height:1.15}
.lampsym{width:40px;height:40px}
.lampsym circle{fill:var(--lampoff);stroke:var(--blockstroke);stroke-width:2}
.lampsym line{stroke:var(--blockstroke);stroke-width:2}
.qout.on .lampsym circle{fill:var(--lamp)}
.qout.on .lampsym{filter:drop-shadow(0 0 8px var(--lamp))}
.lcd{background:var(--lcd);color:var(--lcdink);border-radius:6px;padding:6px 8px;font-family:ui-monospace,Consolas,monospace;font-size:13px;line-height:1.5;
  border:3px solid #6b7680;align-self:center;white-space:pre}
.lcd .x{background:var(--lcdink);color:var(--lcd);border-radius:2px}
.sbtns{display:flex;flex-direction:column;gap:6px;justify-content:center}
.sbtn{border:1px solid var(--border);background:var(--card);border-radius:8px;padding:6px 10px;cursor:pointer;white-space:nowrap;min-height:34px}
@media (hover:hover){.sbtn:hover{background:var(--btnh)}}
.sbtn:active{background:var(--btnh)}
@media (max-height:520px){
  .gbtn{width:46px;height:40px}.gbtn svg{width:32px;height:38px}
  .lampsym{width:30px;height:30px}.geb,.qout{min-width:60px;padding:3px 2px;gap:1px}
  .gsub{font-size:9px}.lcd{font-size:11px;padding:4px 6px}.sbtn{min-height:30px;padding:4px 8px}
  #menubar{padding-top:2px;padding-bottom:2px}.mb{min-height:30px}
}
/* ===== Skalierung nach Endgerät (Handy klein · Tablet mittel · PC groß) ===== */
:root{--u:1}
html[data-ui=phone]{--u:.88}
html[data-ui=tablet]{--u:1.12}
html[data-ui=pc]{--u:1.25}
#menubar,#lib,#simbar,#status,#selbar,#zoomCtl,#plant,#trend .th,#mcard,#hintbar,#fsBar,#wlib,#wbar,#wselbar,#wzoom,#whint{zoom:var(--u)}
#pop,#toast{font-size:calc(14px * var(--u))}
#pop button{padding:calc(9px * var(--u)) calc(10px * var(--u))}
#menubar.c1 #btnTable .lbl,#menubar.c1 #btnZuo .lbl,#menubar.c1 #btnPlan .lbl,#menubar.c1 #btnCheck .lbl,#menubar.c1 #btnNew .lbl,#menubar.c1 #btnUndo .lbl,#menubar.c1 #btnRedo .lbl,#menubar.c1 #btnSave .lbl,#menubar.c1 #btnUi .lbl,#menubar.c1 #btnFs .lbl{display:none}
#menubar.c2 .mb .lbl{display:none}#menubar.c2 .title .chip{max-width:110px}
/* ===== Vollbild ===== */
#fsBar{position:fixed;top:calc(6px + env(safe-area-inset-top));right:calc(6px + env(safe-area-inset-right));display:none;gap:6px;z-index:31}
#fsBar button{width:40px;height:40px;border-radius:10px;border:1px solid var(--border);background:var(--card);box-shadow:var(--shadow);font-size:18px;cursor:pointer;color:var(--ink)}
body.fs #fsBar{display:flex}
body.fs #menubar{position:absolute;left:0;right:0;top:0;z-index:30;transform:translateY(-110%);transition:transform .2s;box-shadow:var(--shadow);padding-right:110px}
body.fs.menuOn #menubar{transform:none}
body.fs #status{display:none}
body.fs #app{padding-top:0}
body.fs #plant{top:58px}
body.fs #selbar{top:56px}
.uiopt{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:8px 0}
.uiopt button{border:2px solid var(--border);background:var(--btn);border-radius:10px;padding:10px 8px;cursor:pointer;text-align:left}
.uiopt button.on{border-color:var(--sel);background:var(--selfill)}
.uiopt b{display:block}.uiopt small{color:var(--muted)}
/* Anlagenfenster */
#plant{position:absolute;right:58px;top:8px;width:340px;max-width:calc(100% - 70px);max-height:calc(100% - 16px);overflow:auto;background:var(--card);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);display:none;overflow:hidden}
#plant.show{display:block}
#plant .ph{display:flex;align-items:center;justify-content:space-between;padding:6px 8px;background:var(--bar);color:var(--bartext);font-weight:700;font-size:13px}
#plant .ph button{background:transparent;border:none;color:inherit;font-size:16px;cursor:pointer}
#plant .pb{padding:6px 8px;display:flex;gap:8px;align-items:flex-start}
#plant .pctl{flex:1;min-width:0}
#plant svg{width:140px;flex:0 0 140px;height:auto;display:block}
.prow{display:flex;gap:6px;align-items:center;justify-content:space-between;margin-top:4px;font-size:12px;flex-wrap:wrap}
.pl{display:flex;align-items:center;gap:4px}
.pl i{width:12px;height:12px;border-radius:50%;background:var(--lampoff);border:1.5px solid var(--blockstroke);display:inline-block}
.pl i.on{background:var(--lamp);box-shadow:0 0 6px var(--lamp)}
.pl i.red.on{background:#ff5a2a;box-shadow:0 0 6px #ff5a2a}
#pmsg{font-size:12px;min-height:16px;margin-top:4px;font-weight:600}
#pmsg.err{color:var(--hi);animation:blink .6s infinite}
@keyframes blink{50%{opacity:.35}}
.mush{width:44px;height:44px;border-radius:50%;border:3px solid #e8c300;background:radial-gradient(circle at 40% 35%,#ff6d6d,#c40000);cursor:pointer;box-shadow:0 3px 0 #7a0000;color:#fff;font-size:9px;font-weight:700}
.mush.on{transform:translateY(2px);box-shadow:0 1px 0 #7a0000;filter:brightness(.8)}
/* Dialoge */
#modal{position:fixed;inset:0;background:rgba(0,0,0,.4);display:none;align-items:center;justify-content:center;z-index:50;padding:10px}
#modal.show{display:flex}
#mcard{background:var(--card);border-radius:14px;box-shadow:var(--shadow);max-width:620px;width:100%;max-height:92%;display:flex;flex-direction:column;border:1px solid var(--border)}
#mhead{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--border);font-weight:700;font-size:16px}
#mhead button{border:none;background:transparent;font-size:20px;cursor:pointer}
#mbody{padding:12px 14px;overflow:auto;-webkit-user-select:text;user-select:text;line-height:1.45}
