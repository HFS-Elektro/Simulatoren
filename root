    const g=S.geber[b.addr];
    openModal(`Parameter – Eingang ${b.addr}`,`
      <div class="frm">
        <label>Klemme</label><select id="pAddr">${IADDR.map(a=>`<option ${a===b.addr?'selected':''}>${a}</option>`).join('')}</select>
