function planPDF(){planCanvas(c=>{c.toBlob(async b=>{
  const jpg=new Uint8Array(await b.arrayBuffer());const land=c.width>=c.height;
  const PW=land?842:595,PH=land?595:842,m=28;const s=Math.min((PW-2*m)/c.width,(PH-2*m)/c.height);
  const iw=c.width*s,ih=c.height*s,ix=(PW-iw)/2,iy=(PH-ih)/2;
  const enc=new TextEncoder();const parts=[];let len=0;const off=[];
  const add=x=>{const u=typeof x==='string'?enc.encode(x):x;parts.push(u);len+=u.length;};
  const obj=(n,body)=>{off[n]=len;add(`${n} 0 obj\n${body}\nendobj\n`);};
  add('%PDF-1.4\n%\xE2\xE3\xCF\xD3\n');
  obj(1,'<</Type/Catalog/Pages 2 0 R>>');
  obj(2,'<</Type/Pages/Kids[3 0 R]/Count 1>>');
  obj(3,`<</Type/Page/Parent 2 0 R/MediaBox[0 0 ${PW} ${PH}]/Resources<</XObject<</Im0 4 0 R>>>>/Contents 5 0 R>>`);
  off[4]=len;add(`4 0 obj\n<</Type/XObject/Subtype/Image/Width ${c.width}/Height ${c.height}/ColorSpace/DeviceRGB/BitsPerComponent 8/Filter/DCTDecode/Length ${jpg.length}>>\nstream\n`);add(jpg);add('\nendstream\nendobj\n');
  const cs=`q ${iw.toFixed(2)} 0 0 ${ih.toFixed(2)} ${ix.toFixed(2)} ${iy.toFixed(2)} cm /Im0 Do Q`;
  obj(5,`<</Length ${cs.length}>>\nstream\n${cs}\nendstream`);
  const xr=len;add(`xref\n0 6\n0000000000 65535 f \n`+[1,2,3,4,5].map(n=>String(off[n]).padStart(10,'0')+' 00000 n \n').join(''));
  add(`trailer\n<</Size 6/Root 1 0 R>>\nstartxref\n${xr}\n%%EOF`);
  dlBlob(new Blob(parts,{type:'application/pdf'}),planName('pdf'));toast('PDF wird gespeichert.');
},'image/jpeg',0.93);});}
