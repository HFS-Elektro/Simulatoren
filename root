  // Leitung, die gerade gezogen wird
  h+=handles;
  if(act&&act.k==='box'&&act.moved){const x=Math.min(act.w0.x,act.w1.x),y=Math.min(act.w0.y,act.w1.y);
    h+=`<rect class="selbox" x="${x}" y="${y}" width="${Math.abs(act.w1.x-act.w0.x)}" height="${Math.abs(act.w1.y-act.w0.y)}"/>`;}
  const tmpFrom=act&&act.k==='wire'&&act.moved?act:(pending&&pendCur?{kind:pending.kind,id:pending.id,pin:pending.pin,cur:pendCur}:null);
  if(tmpFrom){const b=byId(tmpFrom.id);if(b){const g=geom(b);const p=tmpFrom.kind==='pin-out'?g.out:g.ins[tmpFrom.pin];
    if(p)h+=`<path class="wtmp" d="M${p.x} ${p.y}L${tmpFrom.cur.x} ${tmpFrom.cur.y}"/>`;}}
  world.innerHTML=h;
  $('#welcome').style.display=S.blocks.length?'none':'block';
  $('#stInfo').textContent=`Bausteine: ${S.blocks.length} · Verbindungen: ${S.wires.length}`;
