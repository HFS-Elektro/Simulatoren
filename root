  if(S.hw==='24')AIADDR.forEach(a=>{const s=S.asens[a];if(used(a))rows.push([`${a} (${AIPIN[a]})`,s.name,`Analogsensor${s.txt?' „'+s.txt+'“':''}, 0…10 V ≙ ${fmtN(s.min,s.dec)}…${fmtN(s.max,s.dec)} ${s.unit}`,'analog']);});
