      if(b.t==='STAIR'&&v.W>0&&v.W>=v.T){toast('Die Vorwarnung muss kürzer sein als T.');return;}
      change(()=>{Object.assign(b.p,v);});closeModal();};
    return;
  }
  if(b.t==='M'){
    openModal(`Parameter – Merker ${b.addr}`,`<div class="frm">
      <label>Merker</label><select id="pAddr">${MADDR.map(a=>`<option ${a===b.addr?'selected':''}>${a}</option>`).join('')}</select>
