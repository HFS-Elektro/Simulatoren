let simTimer=null,trendData=[],trendPause=false;const TWIN=15;
function needsTick(ctx){return Object.values((ctx||sim).mem).some(m=>m&&typeof m==='object'&&((m.t0!==null&&m.t0!==undefined)||m.tk));}
function simTick(){
  if(mode!=='sim')return;
  if(sim.first){sim.first=false;updateSim();}
  else if(needsTick())updateSim();
  if(!trendPause){const now=performance.now()/1000;const q=qVals(sim);const v={};
    trendSigs().forEach(s=>{v[s.k]=s.get(q);});trendData.push({t:now,v});
    while(trendData.length&&trendData[0].t<now-TWIN-1)trendData.shift();}
  if($('#trend').classList.contains('show'))drawTrend();
}
function trendSigs(){
  const L=[];
  usedInputs().forEach(a=>{const g=S.geber[a];L.push({k:a,lbl:a,sub:g.name,ana:false,get:()=>sim.term[a]||0});});
  usedAI().forEach(a=>{const s=S.asens[a];L.push({k:a,lbl:a,sub:s.name+' '+s.unit,ana:true,min:s.min,max:s.max,dec:s.dec,get:()=>toPhys(aRaw[a],s)});});
  [...new Set(S.blocks.filter(b=>b.t==='Q').map(b=>b.addr))].sort().forEach(a=>{const qi=S.qinfo[a];L.push({k:a,lbl:a,sub:qi.name,ana:false,get:q=>q[a]||0});});
  S.blocks.filter(b=>b.t==='M').sort((x,y)=>x.addr.localeCompare(y.addr)).forEach(b=>{L.push({k:b.addr,lbl:b.addr,sub:(S.minfo[b.addr]||{}).txt||'Merker',ana:false,get:()=>sim.val[b.id]||0});});
  return L;
}
function drawTrend(){
  const cv=$('#trendCv'),box=$('#trendBox');if(!cv||!box.clientWidth)return;
  const sigs=trendSigs();const RH=26,RA=52,LW=74,dpr=window.devicePixelRatio||1,U=uiScale||1;
  const H=Math.max(40,sigs.reduce((a,s)=>a+(s.ana?RA:RH),0)+22),W=box.clientWidth/U;
  if(cv.width!==Math.round(W*U*dpr)||cv.height!==Math.round(H*U*dpr)){cv.width=Math.round(W*U*dpr);cv.height=Math.round(H*U*dpr);cv.style.height=(H*U)+'px';}
  const c=cv.getContext('2d');c.setTransform(dpr*U,0,0,dpr*U,0,0);
  const cs=getComputedStyle(document.documentElement);const col=n=>cs.getPropertyValue(n).trim();
  c.clearRect(0,0,W,H);c.font='11px system-ui,sans-serif';
  const now=trendData.length?trendData[trendData.length-1].t:performance.now()/1000;
  const X=t=>LW+(W-LW-8)*(1-(now-t)/TWIN);
  c.strokeStyle=col('--border');c.fillStyle=col('--muted');c.lineWidth=1;
  for(let s=0;s<=TWIN;s+=1){const x=X(now-s);c.beginPath();c.moveTo(x,0);c.lineTo(x,H-16);c.globalAlpha=s%5===0?0.9:0.35;c.stroke();c.globalAlpha=1;
    if(s%5===0)c.fillText(s?`−${s} s`:'jetzt',x-(s?14:22),H-4);}
  let y=4;
  sigs.forEach(sg=>{
    const rh=sg.ana?RA:RH;
    c.fillStyle=col('--ink');c.font='bold 11px system-ui,sans-serif';c.fillText(sg.lbl,4,y+12);
    c.fillStyle=col('--muted');c.font='10px system-ui,sans-serif';c.fillText(trunc((sg.sub||'').trim(),11),4,y+24);
    c.strokeStyle=col('--border');c.beginPath();c.moveTo(LW,y+rh-2);c.lineTo(W-8,y+rh-2);c.stroke();
    if(trendData.length>1){
      if(!sg.ana){
        c.lineWidth=2;let prev=null;
        trendData.forEach(d=>{const v=d.v[sg.k]??0;const x=Math.max(LW,X(d.t));const yy=v?y+4:y+rh-6;
          if(prev){c.strokeStyle=prev.v?col('--hi'):col('--lo');c.beginPath();c.moveTo(prev.x,prev.y);c.lineTo(x,prev.y);c.lineTo(x,yy);c.stroke();
            if(prev.v){c.fillStyle=col('--hi');c.globalAlpha=.12;c.fillRect(prev.x,y+4,x-prev.x,rh-10);c.globalAlpha=1;}}
          prev={x,y:yy,v};});
      }else{
        const lo=Math.min(sg.min,sg.max),hi=Math.max(sg.min,sg.max);const Y=v=>y+rh-6-(rh-12)*((v-lo)/((hi-lo)||1));
        c.strokeStyle=col('--an');c.lineWidth=2;c.beginPath();
        trendData.forEach((d,i)=>{const x=Math.max(LW,X(d.t));const yy=Y(d.v[sg.k]??lo);i?c.lineTo(x,yy):c.moveTo(x,yy);});c.stroke();
        const last=trendData[trendData.length-1].v[sg.k];c.fillStyle=col('--an');c.font='bold 11px system-ui,sans-serif';
        if(last!==undefined)c.fillText(fmtN(last,sg.dec),W-60,y+12);
      }
    }
    y+=rh;
  });
  $('#trendInfo').textContent=trendPause?'angehalten':`letzte ${TWIN} s`;
}
