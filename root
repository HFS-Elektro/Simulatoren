.fab{width:40px;height:40px;border-radius:50%;border:1px solid var(--border);background:var(--card);box-shadow:var(--shadow);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center}
#selbar{position:absolute;left:50%;top:8px;transform:translateX(-50%);display:none;gap:4px;background:var(--card);border:1px solid var(--border);
  border-radius:10px;box-shadow:var(--shadow);padding:4px;white-space:nowrap;max-width:96%;overflow-x:auto}
#selbar.show{display:flex}
