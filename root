  add('Besichtigen',c.els.some(e=>e.type==='ls'||e.type==='rcbo'),c.els.some(e=>e.type==='ls'||e.type==='rcbo')?'Überstrom-Schutzeinrichtung (LS) vorhanden':'Kein LS-Schalter vorhanden');
