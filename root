/* Verbindungspunkte: dort, wo sich Leitungen derselben Quelle verzweigen (≥3 Richtungen) */
function junctions(){
  const grp=new Map(),out=[];
  S.wires.forEach(w=>{const r=routePts(w);if(!r)return;if(!grp.has(w.f))grp.set(w.f,[]);grp.get(w.f).push(r.pts);});
  grp.forEach((list,f)=>{
    if(list.length<2)return;
    const segs=[];list.forEach(pts=>{for(let k=0;k<pts.length-1;k++){const p=pts[k],q=pts[k+1];if(p.x!==q.x||p.y!==q.y)segs.push([p,q]);}});
    const seen=new Set();
    list.forEach(pts=>pts.forEach(P=>{const key=P.x+','+P.y;if(seen.has(key))return;seen.add(key);
      const d=new Set();
      segs.forEach(([p,q])=>{
        const onH=p.y===q.y&&P.y===p.y&&P.x>=Math.min(p.x,q.x)&&P.x<=Math.max(p.x,q.x);
        const onV=p.x===q.x&&P.x===p.x&&P.y>=Math.min(p.y,q.y)&&P.y<=Math.max(p.y,q.y);
        if(!onH&&!onV)return;
        const dir=(A,B)=>A.y===B.y?(B.x>A.x?'R':'L'):(B.y>A.y?'D':'U');
        if(P.x===p.x&&P.y===p.y)d.add(dir(p,q));else if(P.x===q.x&&P.y===q.y)d.add(dir(q,p));else{d.add(dir(P,p));d.add(dir(P,q));}
      });
