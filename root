      else if(isAnaOut(b.t)){const r=rngOf(b);h+=`<text class="flag an" x="${g.out.x+2}" y="${g.out.y-5}">${fmtN(toPhys(v,r),r.dec)}</text>`;}
      else h+=`<text class="flag ${v?'hi':'lo'}" x="${g.out.x+2}" y="${g.out.y-5}">${v}</text>`;
