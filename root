/* Abgabeschutz für Projektdateien: Inhalt wird verschleiert (XOR-Schlüsselstrom) und mit einer Prüfsumme versehen.
   Kein echter Kryptoschutz – der Schlüssel steht in dieser Datei –, aber Änderungen mit einem Texteditor fallen beim Import auf.
   Format v:2 = {format:'hfs-logo-sim', v:2, n:Zufallswert, d:Base64-Daten, c:Prüfsumme}; v:1 (Klartext) wird weiter gelesen. */
const XK='HFS·LOGO·Lab·Abgabeschutz·2026';
function xHash(str,seed){let h1=0xdeadbeef^seed,h2=0x41c6ce57^seed;
  for(let i=0;i<str.length;i++){const c=str.charCodeAt(i);h1=Math.imul(h1^c,2654435761);h2=Math.imul(h2^c,1597334677);}
  h1=Math.imul(h1^(h1>>>16),2246822507)^Math.imul(h2^(h2>>>13),3266489909);h2=Math.imul(h2^(h2>>>16),2246822507)^Math.imul(h1^(h1>>>13),3266489909);
  return (h2>>>0).toString(16).padStart(8,'0')+(h1>>>0).toString(16).padStart(8,'0');}
function xStream(b,nonce){const s=[1,2,3,4].map(i=>(parseInt(xHash(XK+nonce,i).slice(0,8),16)|1)>>>0);
  for(let i=0;i<b.length;i++){if(i%4===0){let t=s[3];t^=t<<11;t^=t>>>8;s[3]=s[2];s[2]=s[1];s[1]=s[0];t^=s[0]^(s[0]>>>19);s[0]=t>>>0;}
    b[i]^=(s[0]>>>((i%4)*8))&255;}
  return b;}
function xPack(obj){const json=JSON.stringify(obj),n=Math.random().toString(36).slice(2,10)+Date.now().toString(36);
  const b=xStream(new TextEncoder().encode(json),n);let s='';for(let i=0;i<b.length;i+=8192)s+=String.fromCharCode.apply(null,b.subarray(i,i+8192));
  return {format:'hfs-logo-sim',v:2,n,d:btoa(s),c:xHash(XK+n+json,7)};}
function xUnpack(o){const bin=atob(o.d),b=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)b[i]=bin.charCodeAt(i);
  const json=new TextDecoder().decode(xStream(b,String(o.n)));return {inner:JSON.parse(json),ok:xHash(XK+o.n+json,7)===o.c};}
function exportFile(){
  const data=xPack({name:cur.name,saved:new Date().toISOString(),data:S});
  const blob=new Blob([JSON.stringify(data)],{type:'application/json'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);
  a.download=(cur.name||'Projekt').replace(/[\\/:*?"<>|]+/g,'_')+'.logo.json';
  document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},2000);
  toast('Datei wird heruntergeladen.');
}
