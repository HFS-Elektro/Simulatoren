table.tt td.o{font-weight:700}
table.tt td.v1{color:var(--hi)}table.tt td.v0{color:var(--lo)}
table.tt tr.cur td{background:var(--selfill);outline:2px solid var(--sel)}
table.tt th.osep,table.tt td.osep{border-left:3px double var(--ink)}
.chk{list-style:none;padding:0;margin:0}
.chk li{padding:6px 4px;border-bottom:1px solid var(--border);display:flex;gap:8px}
.en{display:inline-block;font-size:12px;background:var(--selfill);color:var(--ink);padding:1px 7px;border-radius:9px;margin-left:6px;font-weight:600}
.symbig{display:inline-flex;width:54px;height:40px;border:2px solid var(--blockstroke);align-items:center;justify-content:center;font-weight:700;font-size:18px;margin-right:10px;vertical-align:middle;background:var(--blockfill)}
#toast{position:fixed;left:50%;top:calc(140px * var(--u) + env(safe-area-inset-top));transform:translateX(-50%);background:#222;color:#fff;padding:9px 14px;border-radius:9px;font-size:13px;opacity:0;transition:opacity .25s;pointer-events:none;z-index:60;max-width:90%;text-align:center}
#toast.show{opacity:.94}
#pop{position:fixed;display:none;flex-direction:column;background:var(--card);border:1px solid var(--border);border-radius:10px;box-shadow:var(--shadow);z-index:40;padding:4px;min-width:170px}
#pop.show{display:flex}
#pop button{border:none;background:transparent;text-align:left;padding:9px 10px;border-radius:7px;cursor:pointer}
@media (hover:hover){#pop button:hover{background:var(--btnh)}}
#pop button:active{background:var(--btnh)}
#rot{position:fixed;inset:0;background:var(--bar);color:#fff;z-index:80;display:none;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px;gap:14px}
#rot .big{font-size:56px;animation:rotp 2s infinite}
@keyframes rotp{50%{transform:rotate(-90deg)}}
@media (orientation:portrait) and (max-width:700px){body:not(.portraitok) #rot{display:flex}}
