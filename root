/* Quellen: Steuerstromschienen und (falls eingeblendet) Hauptstromschienen L1, L2, L3, N, PE */
function wSrc(){const s=[['RL',S.hw==='24'?'P24':'L1'],['RN',S.hw==='24'?'M24':'N'],['RSPE','PE']];
