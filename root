<script>
(function(){
'use strict';
var LS={get:function(k){try{return localStorage.getItem(k)}catch(e){return null}},set:function(k,v){try{localStorage.setItem(k,v)}catch(e){}}};
function $(id){return document.getElementById(id)}

/* Gerät erkennen und passende Anleitung aufklappen */
var ua=navigator.userAgent, ios=/iPad|iPhone|iPod/.test(ua)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1), android=/Android/.test(ua);
var g=ios?'ios':android?'android':'pc';
[].forEach.call(document.querySelectorAll('.geraet'),function(d){d.style.display='block';if(d.getAttribute('data-g')===g)d.open=true});
var standalone=window.matchMedia('(display-mode: standalone)').matches||navigator.standalone;
if(standalone)$('hinweise').querySelector('h2').textContent='Hilfe';

/* Versionen anzeigen */
fetch('version.json',{cache:'no-cache'}).then(function(r){return r.json()}).then(function(v){
 if(v.schaltungssimulator)$('v-sim').textContent='Version '+v.schaltungssimulator;
 if(v.logolab)$('v-logo').textContent='Version '+v.logolab;
 if(v.stand)$('stand').textContent='Stand '+v.stand;
}).catch(function(){});

/* Klasse aus dem QR-Code (?k=CODE) übernehmen */
var klassen=[];
/* Eine Home-Bildschirm-App hat auf dem iPad einen eigenen Speicher. Deshalb: Klasse aus ?k=, sonst gespeichert, sonst Auswahl. */
function zeigeKlasse(k){
 if(!k){$('klasse').style.display='none';return}
 $('kwahl').style.display='none';
 $('klasse').style.display='flex';$('kname').textContent=k.name||k.code;
 if(k.abgabe){$('kabgabe').style.display='';$('kabgabe').href=k.abgabe;$('kinfo').textContent='Abgaben lädst du über „Abgabe öffnen“ hoch.'}
 else{$('kabgabe').style.display='none';$('kinfo').textContent=''}
}
function finde(c){c=(c||'').toLowerCase();return klassen.filter(function(x){return x.code.toLowerCase()===c})[0]}
function merke(k){LS.set('hfs_klasse',JSON.stringify(k));zeigeKlasse(k)}
function gespeichert(){try{var k=JSON.parse(LS.get('hfs_klasse'));if(k){var n=finde(k.code);return n||k}}catch(e){}return null}
var code=(new URLSearchParams(location.search).get('k')||'').trim();
fetch('klassen.json',{cache:'no-cache'}).then(function(r){return r.json()}).then(function(d){
 klassen=(d&&d.klassen)||[];
 klassen.forEach(function(k){
  var o=document.createElement('option');o.value=k.code;o.textContent=k.name||k.code;$('ksel').appendChild(o);
  $('kwsel').appendChild(o.cloneNode(true));
 });
 var k=(code&&finde(code))||gespeichert();
 if(k)merke(k);else if(klassen.length)$('kwahl').style.display='flex';
}).catch(function(){zeigeKlasse(gespeichert())});
$('kwsel').onchange=function(){var k=finde(this.value);if(k)merke(k)};
$('kwechsel').onclick=function(e){e.preventDefault();$('klasse').style.display='none';$('kwsel').value='';$('kwahl').style.display='flex'};

/* Offline: Service Worker anmelden und beide Simulatoren vorab speichern */
var DATEIEN={sim:['schaltungssimulator.html','HFS-Simulator.webmanifest','HFS-Simulator-icon.png'],logo:['logo-lab.html','logo-lab-icon.png']};
function status(id,t,ok){var e=$(id);e.textContent=t;e.className='status'+(ok?' ok':'')}
if(/^https?:$/.test(location.protocol)&&'serviceWorker' in navigator&&window.caches){
 navigator.serviceWorker.register('HFS-Simulator-sw.js').then(function(){
  return caches.open('hfs-sim').then(function(c){
   c.addAll(['./','index.html','titel.jpg','start.webmanifest','version.json']).catch(function(){});
   Object.keys(DATEIEN).forEach(function(n){
    var id=n==='sim'?'s-sim':'s-logo';
    if(!navigator.onLine){caches.match(DATEIEN[n][0],{ignoreSearch:true}).then(function(m){status(id,m?'✓ offline verfügbar':'Erst mit Internet einmal öffnen',!!m)});return}
    status(id,'wird für offline gespeichert …');
    c.addAll(DATEIEN[n]).then(function(){status(id,'✓ offline verfügbar',true)}).catch(function(){status(id,'')});
   });
  });
 }).catch(function(){});
}

/* Lehrkräfte: QR-Code */
function lehrer(){var on=location.hash==='#lehrer';$('lehrer').style.display=on?'block':'none';if(on)$('lehrer').scrollIntoView()}
window.addEventListener('hashchange',lehrer);lehrer();
function zielLink(){
 var basis=location.href.split('#')[0].split('?')[0].replace(/index\.html$/,'');
 var ziel=$('kziel').value, k=$('ksel').value;
 return basis+(ziel||'')+(k?'?k='+encodeURIComponent(k):'');
}
var qrLib=null;
function ladeQr(cb){
 if(window.QRCode)return cb();
 var s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
 s.onload=cb;s.onerror=function(){alert('Der QR-Code-Baustein konnte nicht geladen werden (keine Internetverbindung?).')};document.head.appendChild(s);
}
function machQr(){
 var link=zielLink();
 ladeQr(function(){
  $('qr').innerHTML='';new QRCode($('qr'),{text:link,width:512,height:512,correctLevel:QRCode.CorrectLevel.M});
  $('qrlink').textContent=link;var o=$('ksel').selectedOptions[0];$('qrname').textContent=$('ksel').value?o.textContent:'';
  $('qrbox').style.display='block';
 });
}
$('qrmach').onclick=machQr;
$('qrdruck').onclick=function(){if($('qrbox').style.display!=='block'){machQr();setTimeout(function(){window.print()},800)}else window.print()};
$('qrkopie').onclick=function(){var l=zielLink();if(navigator.clipboard)navigator.clipboard.writeText(l).then(function(){$('qrkopie').textContent='✓ kopiert'});else prompt('Link:',l)};
/* Hinweis: Mit ?k= auf einer Simulator-Seite übernimmt diese Startseite die Klasse nicht. Daher führt der QR-Code mit Klasse immer über die Startseite. */
$('kziel').onchange=function(){if($('kziel').value&&$('ksel').value){$('ksel').value='';alert('Mit Klasse führt der QR-Code auf die Startseite, damit das Gerät die Klasse speichern kann.')}};
$('ksel').onchange=function(){if($('ksel').value)$('kziel').value=''};
})();
</script>
