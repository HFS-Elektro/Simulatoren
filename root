/* Kontakt senkrecht: Klemme oben y=0, unten y=80. Schließer: Schaltglied nach links offen; Öffner: Schaltglied nach rechts am Haken */
function cSym(cx,ct,closed,cT,cB,ac,latch,on){
  let h=`<line class="wl" x1="${cx}" y1="0" x2="${cx}" y2="30" stroke="${cT}"/><line class="wl" x1="${cx}" y1="50" x2="${cx}" y2="80" stroke="${cB}"/>`;
  let ex,ey;
  if(ct==='NO'){if(closed){ex=cx;ey=30;}else{ex=cx-11;ey=30;}}
  else{h+=`<line class="wl" x1="${cx}" y1="30" x2="${cx+12}" y2="30" stroke="${cT}"/>`;if(closed){ex=cx+10;ey=27.5;}else{ex=cx-10;ey=31;}}
  h+=`<line class="wl" x1="${cx}" y1="50" x2="${ex}" y2="${ey}" stroke="${closed?cT:cB}"/>`;
  if(ct==='NC')h+=`<circle cx="${cx}" cy="50" r="2.3" fill="${cB}" style="pointer-events:none"/>`;
  if(ac!==undefined){
    const t=10/(50-ey),mx=cx+(ex-cx)*t,ax=cx-20,cl=on?' on':'';
    if(ac==='prox'){ // Näherungsschalter: Raute mit zwei senkrechten Strichen, feste Wirklinie
      h+=`<path class="wact${cl}" d="M${ax-6} 40L${ax+2} 31L${ax+10} 40L${ax+2} 49Z M${ax} 33.3V46.7 M${ax+4} 33.3V46.7"/><line class="wl" x1="${ax+10}" y1="40" x2="${mx}" y2="40" stroke="var(--ink)"/>`;
    }else if(ac==='roll'){ // Rollenschalter (Positionsschalter mit Rolle): Kreis, feste Wirklinie
      h+=`<circle class="wact${cl}" cx="${ax+1}" cy="40" r="4.8"/><line class="wl" x1="${ax+5.8}" y1="40" x2="${mx}" y2="40" stroke="var(--ink)"/>`;
    }else if(ac)h+=`<line class="wlink" x1="${ax}" y1="40" x2="${mx}" y2="40"/>`;
    if(ac==='push')h+=`<path class="wact${cl}" d="M${ax+4} 34H${ax}V46H${ax+4}"/>`;
    if(ac==='turn')h+=`<path class="wact${cl}" d="M${ax-3} 34H${ax}V46H${ax+3}"/>`;
    if(ac==='mush')h+=`<path class="wact${cl}" d="M${ax} 32.5A7.5 7.5 0 0 0 ${ax} 47.5Z"/>`;
    if(ac==='therm')h+=`<path class="wact${cl}" d="M${ax-10} 45H${ax-5}V35H${ax}V40"/>`;
    if(ac==='man')h+=`<path class="wact${cl}" d="M${ax} 34V46"/>`;
    if(latch)h+=`<path class="wact${cl}" d="M${ax+7} 40L${ax+9.5} 45L${ax+12} 40"/>`;
  }
  return h;
}
