function parText(b,isSim){
  const p=b.p;if(!p)return '';
  const m=sim.mem[b.id];
  switch(b.t){
    case 'TON':case 'TOF':return isSim?`Ta = ${fmtN(m?m.ta:0,2)} s / ${fmtN(p.T,2)} s`:`T = ${fmtN(p.T,2)} s`;
    case 'CTR':return isSim?`Cv = ${m?m.cv:(p.st||0)}  (On ${p.on} · Off ${p.off})`:`On = ${p.on} · Off = ${p.off}`;
    case 'ATH':{const r=rngOf(b);return isSim?`Ax = ${fmtN(m?m.x:toPhys(0,r),r.dec)} ${esc(r.unit)}`:`Ein > ${fmtN(p.on,r.dec)} · Aus ≤ ${fmtN(p.off,r.dec)} ${esc(r.unit)}`;}
    case 'ACMP':{const r=rngOf(b);return isSim?`Ax−Ay = ${fmtN(m?m.x:0,r.dec)} ${esc(r.unit)}`:`Ein > ${fmtN(p.on,r.dec)} · Aus ≤ ${fmtN(p.off,r.dec)} ${esc(r.unit)}`;}
    case 'AMP':{const r=rngOf(b);return isSim?`${fmtN(toPhys(sim.val[b.id]||0,r),r.dec)} ${esc(r.unit)}`:`${fmtN(r.min,r.dec)}…${fmtN(r.max,r.dec)} ${esc(r.unit)}`;}
    case 'TONR':case 'WIPE':return isSim?`Ta = ${fmtN(m?m.ta:0,2)} s / ${fmtN(p.T,2)} s`:`T = ${fmtN(p.T,2)} s`;
    case 'BLINK':return `TH = ${fmtN(p.TH,2)} s · TL = ${fmtN(p.TL,2)} s`;
    case 'STAIR':return isSim?`Ta = ${fmtN(m?m.ta:0,1)} s / ${fmtN(p.T,1)} s`:`T = ${fmtN(p.T,1)} s`+(p.W>0?` · Warnung ${fmtN(p.W,1)} s`:'');
    case 'COMF':return isSim?(m&&m.perm?'Dauerlicht':`Ta = ${fmtN(m?m.ta:0,1)} s / TH ${fmtN(p.TH,1)} s`):`TH = ${fmtN(p.TH,1)} s · TL = ${fmtN(p.TL,1)} s`;
  }
  return '';
}
